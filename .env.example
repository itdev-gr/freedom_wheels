# Supabase backend (public/anon — safe to ship to the browser).
# Reads use the anon key; writes go through anon-safe RPCs only.
# Never put a Supabase service-role key in this site.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
PUBLIC_PROJECT_ID=your-project-id

# Stripe secret key used by /api/create-checkout (server-side only).
STRIPE_SECRET_KEY=sk_live_or_test_...
