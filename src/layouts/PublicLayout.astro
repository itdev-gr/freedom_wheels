---
import type { Locale } from '../locales/en';

interface Props {
	lang: 'en' | 'el';
	title: string;
	description: string;
	canonical?: string;
	ogImage?: string;
	t: Locale;
	/** If false, header starts without scrolled style (e.g. home hero). Default true. */
	headerScrolled?: boolean;
}

const { lang, title, description, canonical, ogImage, t, headerScrolled = true } = Astro.props;

const pathname = Astro.url.pathname;
const base = pathname.replace(/^\/(en|el)\/?/, '/') || '/';
const otherLang = lang === 'en' ? 'el' : 'en';
const otherPath = (otherLang === 'en' ? '/en' : '/el') + (base === '/' ? '' : base);

const site = Astro.site?.href ?? Astro.url.origin;
const canonicalUrl = canonical ?? new URL(pathname, site).href;
const imageUrl = ogImage ?? new URL('/logos/logo.webp', site).href;
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:locale" content={lang === 'el' ? 'el_GR' : 'en_GB'} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<link rel="icon" type="image/webp" href="/logos/logo.webp" />
		<link rel="apple-touch-icon" href="/logos/logo.webp" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
		(function() {
			var script = document.createElement('script');
			script.src = 'https://cbl.link/b/puvpXLZ.js';
			script.async = true;
			document.head.appendChild(script);
		})();
		</script>
		<link rel="alternate" hreflang="en" href={new URL(pathname.replace(/^\/el/, '/en'), site).href} />
		<link rel="alternate" hreflang="el" href={new URL(pathname.replace(/^\/en/, '/el'), site).href} />
	</head>
	<body>
		<header class:list={['nav-bar', headerScrolled && 'nav-bar--scrolled']} id="nav-bar">
			<div class="nav-bar__inner">
				<a href={lang === 'en' ? '/en' : '/el'} class="logo">
					<img src="/logos/logo.webp" alt="Freedom Wheels" class="logo__image" />
				</a>
				<button type="button" class="nav-bar__hamburger" id="nav-bar__hamburger" aria-label="Menu" aria-expanded="false">
					<span class="nav-bar__hamburger-line"></span>
					<span class="nav-bar__hamburger-line"></span>
					<span class="nav-bar__hamburger-line"></span>
				</button>
				<nav class="nav-bar__links">
					<a href={lang === 'en' ? '/en' : '/el'} class="nav-bar__link">{t.nav.home}</a>
					<a href={lang === 'en' ? '/en/rentals' : '/el/rentals'} class="nav-bar__link">{t.nav.rentals}</a>
					<a href={lang === 'en' ? '/en/chania' : '/el/chania'} class="nav-bar__link">{t.nav.chania}</a>
					<a href={lang === 'en' ? '/en/contact' : '/el/contact'} class="nav-bar__link">{t.nav.contact}</a>
					<a href={lang === 'en' ? '/en/book' : '/el/book'} class="nav-bar__cta">{t.nav.bookNow}</a>
					<span class="nav-bar__lang">
						{lang === 'en' ? (
							<>
								<span class="nav-bar__lang-current">En</span>
								<a href={otherPath} class="nav-bar__lang-link" aria-label="Ελληνικά">Gr</a>
							</>
						) : (
							<>
								<a href={otherPath} class="nav-bar__lang-link" aria-label="English">En</a>
								<span class="nav-bar__lang-current">Gr</span>
							</>
						)}
					</span>
				</nav>
			</div>
			<div class="nav-bar__mobile-panel" id="nav-bar__mobile-panel" hidden>
				<a href={lang === 'en' ? '/en' : '/el'} class="nav-bar__mobile-link">{t.nav.home}</a>
				<a href={lang === 'en' ? '/en/rentals' : '/el/rentals'} class="nav-bar__mobile-link">{t.nav.rentals}</a>
				<a href={lang === 'en' ? '/en/chania' : '/el/chania'} class="nav-bar__mobile-link">{t.nav.chania}</a>
				<a href={lang === 'en' ? '/en/contact' : '/el/contact'} class="nav-bar__mobile-link">{t.nav.contact}</a>
				<a href={lang === 'en' ? '/en/book' : '/el/book'} class="nav-bar__mobile-cta">{t.nav.bookNow}</a>
				<span class="nav-bar__mobile-lang">
					{lang === 'en' ? (
						<>
							<span class="nav-bar__lang-current">En</span>
							<a href={otherPath} class="nav-bar__lang-link" aria-label="Ελληνικά">Gr</a>
						</>
					) : (
						<>
							<a href={otherPath} class="nav-bar__lang-link" aria-label="English">En</a>
							<span class="nav-bar__lang-current">Gr</span>
						</>
					)}
				</span>
			</div>
		</header>

		<slot />

		<footer class="site-footer">
			<div class="site-footer__inner">
				<div class="site-footer__col site-footer__company">
					<div class="site-footer__logo">
						<img src="/logos/logo.webp" alt="Freedom Wheels" class="site-footer__logo-img" />
						<span class="site-footer__name">FREEDOM WHEELS</span>
					</div>
					<ul class="site-footer__contact">
						<li>
							<span class="site-footer__icon" aria-hidden="true">📍</span>
							<span>{t.footer.address}</span>
						</li>
						<li>
							<span class="site-footer__icon" aria-hidden="true">📞</span>
							<a href="tel:+302821405794">+30 2821 405 794</a>
						</li>
						<li>
							<span class="site-footer__icon" aria-hidden="true">✉️</span>
							<a href="mailto:info@freedomwheels.gr">info@freedomwheels.gr</a>
						</li>
						<li><span>{t.footer.gemiNo}</span></li>
					</ul>
				</div>
				<div class="site-footer__col site-footer__links">
					<h3 class="site-footer__heading">{t.footer.about}</h3>
					<ul>
						<li><a href={lang === 'en' ? '/en/rental-terms' : '/el/rental-terms'}>{t.footer.rentalTerms}</a></li>
						<li><a href={lang === 'en' ? '/en#policy' : '/el#policy'}>{t.footer.bookingPolicy}</a></li>
						<li><a href={lang === 'en' ? '/en#cookies' : '/el#cookies'}>{t.footer.cookiePolicy}</a></li>
						<li><a href={lang === 'en' ? '/en#terms-use' : '/el#terms-use'}>{t.footer.termsOfUse}</a></li>
						<li><a href={lang === 'en' ? '/en#privacy' : '/el#privacy'}>{t.footer.privacyPolicy}</a></li>
						<li><a href={lang === 'en' ? '/en/contact' : '/el/contact'}>{t.footer.contact}</a></li>
					</ul>
				</div>
				<div class="site-footer__col site-footer__hours">
					<h3 class="site-footer__heading">{t.footer.openingHours}</h3>
					<p class="site-footer__hours-text">{t.footer.monFri}</p>
					<p class="site-footer__hours-text">{t.footer.sat}</p>
					<p class="site-footer__hours-text">{t.footer.sun}</p>
				</div>
			</div>
			<div class="site-footer__bottom">
				<p class="site-footer__copyright">{t.footer.copyright} <a href="https://www.itdev.gr/" target="_blank" rel="noopener noreferrer">IT DEV</a></p>
			</div>
		</footer>

		<style is:global>
			html, body {
				margin: 0;
				padding: 0;
			}
			.site-footer {
				background-color: #1d8299;
				color: #fff;
				padding: 3rem 1rem 0;
				font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
			}
			.site-footer__inner {
				max-width: 1200px;
				margin: 0 auto;
				display: flex;
				gap: 3rem;
				flex-wrap: wrap;
				padding: 0 1rem 2rem;
			}
			.site-footer__col {
				flex: 1 1 200px;
				min-width: 0;
			}
			.site-footer__company {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			.site-footer__logo {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}
			.site-footer__logo-img {
				height: 48px;
				width: auto;
				object-fit: contain;
			}
			.site-footer__name {
				font-size: 1.25rem;
				font-weight: 600;
				letter-spacing: 0.05em;
				color: #fff;
			}
			.site-footer__contact {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}
			.site-footer__contact li {
				display: flex;
				align-items: flex-start;
				gap: 0.5rem;
			}
			.site-footer__icon {
				flex-shrink: 0;
			}
			.site-footer__contact a,
			.site-footer__contact span {
				color: #fff;
				text-decoration: none;
				font-size: 0.95rem;
			}
			.site-footer__contact a:hover {
				text-decoration: underline;
			}
			.site-footer__heading {
				font-size: 1.1rem;
				font-weight: 600;
				margin: 0 0 1rem;
				color: #fff;
				letter-spacing: 0.02em;
			}
			.site-footer__links ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.site-footer__links li {
				margin-bottom: 0.4rem;
			}
			.site-footer__links a {
				color: #fff;
				text-decoration: none;
				font-size: 0.95rem;
			}
			.site-footer__links a:hover {
				text-decoration: underline;
			}
			.site-footer__hours-text {
				margin: 0 0 0.4rem;
				font-size: 0.95rem;
				color: #fff;
			}
			.site-footer__bottom {
				border-top: 1px solid rgba(255, 255, 255, 0.35);
				padding: 1rem 1rem;
				text-align: left;
			}
			.site-footer__copyright {
				margin: 0;
				font-size: 0.85rem;
				color: rgba(255, 255, 255, 0.85);
			}
			.site-footer__copyright a {
				color: rgba(255, 255, 255, 0.9);
				text-decoration: none;
			}
			.site-footer__copyright a:hover {
				text-decoration: underline;
			}
			@media (max-width: 900px) {
				.site-footer {
					margin-top: 20vh;
				}
			}
			.nav-bar {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 30;
				background-color: rgba(85, 83, 86, 0.5);
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
				backdrop-filter: blur(8px);
			}
			.nav-bar__inner {
				max-width: 1200px;
				margin: 0 auto;
				padding: 0.85rem 1rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 2rem;
			}
			.logo {
				display: inline-flex;
				align-items: center;
				color: #ffffff;
				text-decoration: none;
			}
			.logo__image {
				height: 61px;
				width: auto;
				display: block;
			}
			.nav-bar__links {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
			}
			.nav-bar__link {
				display: inline-block;
				padding: 0.5rem 1rem;
				border-radius: 999px;
				background-color: rgba(128, 128, 128, 0.85);
				color: #ffffff;
				font-size: 0.75rem;
				font-weight: 500;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				text-decoration: none;
				transition: background-color 150ms ease-out;
			}
			.nav-bar__link:hover {
				background-color: rgba(100, 100, 100, 0.95);
				color: #ffffff;
			}
			.nav-bar__cta {
				display: inline-block;
				padding: 0.5rem 1.25rem;
				border-radius: 999px;
				background-color: #1a1a1a;
				color: #ffffff;
				font-size: 0.75rem;
				font-weight: 600;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				text-decoration: none;
				transition: background-color 150ms ease-out;
			}
			.nav-bar__cta:hover {
				background-color: #333;
			}
			.nav-bar__lang {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				margin-left: 0.5rem;
				font-size: 0.75rem;
				font-weight: 600;
				letter-spacing: 0.05em;
			}
			.nav-bar__lang-current {
				color: rgba(255, 255, 255, 0.6);
				cursor: default;
			}
			.nav-bar__lang-link {
				color: #ffffff;
				text-decoration: none;
				padding: 0.25rem 0.5rem;
				border-radius: 4px;
				transition: background-color 150ms ease-out;
			}
			.nav-bar__lang-link:hover {
				background-color: rgba(255, 255, 255, 0.2);
			}
			.nav-bar__hamburger {
				display: none;
				flex-direction: column;
				justify-content: center;
				gap: 5px;
				width: 44px;
				height: 44px;
				padding: 0;
				border: none;
				background: rgba(128, 128, 128, 0.85);
				border-radius: 999px;
				cursor: pointer;
				transition: background 150ms ease-out;
			}
			.nav-bar__hamburger:hover {
				background: rgba(100, 100, 100, 0.95);
			}
			.nav-bar__hamburger-line {
				display: block;
				width: 22px;
				height: 2px;
				background: #fff;
				border-radius: 1px;
				margin: 0 auto;
				transition: transform 150ms ease-out, opacity 150ms ease-out;
			}
			.nav-bar--menu-open .nav-bar__hamburger-line:nth-child(1) {
				transform: translateY(7px) rotate(45deg);
			}
			.nav-bar--menu-open .nav-bar__hamburger-line:nth-child(2) {
				opacity: 0;
			}
			.nav-bar--menu-open .nav-bar__hamburger-line:nth-child(3) {
				transform: translateY(-7px) rotate(-45deg);
			}
			.nav-bar__mobile-panel {
				display: none;
				flex-direction: column;
				gap: 0.5rem;
				padding: 1rem 1rem 1.5rem;
				background-color: rgba(85, 83, 86, 0.5);
				backdrop-filter: blur(8px);
				border-top: 1px solid rgba(255, 255, 255, 0.15);
			}
			.nav-bar__mobile-link,
			.nav-bar__mobile-cta {
				display: block;
				padding: 0.5rem 1rem;
				border-radius: 999px;
				color: #ffffff;
				text-decoration: none;
				font-size: 0.75rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				text-align: center;
				transition: background 150ms ease-out;
			}
			.nav-bar__mobile-link {
				background: rgba(128, 128, 128, 0.85);
				font-weight: 500;
			}
			.nav-bar__mobile-link:hover {
				background: rgba(100, 100, 100, 0.95);
				color: #ffffff;
			}
			.nav-bar__mobile-cta {
				background: #1a1a1a;
				font-weight: 600;
				letter-spacing: 0.14em;
			}
			.nav-bar__mobile-cta:hover {
				background: #333;
				color: #ffffff;
			}
			.nav-bar__mobile-lang {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.35rem;
				margin-top: 0.5rem;
				padding-top: 0.75rem;
				border-top: 1px solid rgba(255, 255, 255, 0.2);
				font-size: 0.75rem;
				font-weight: 600;
				letter-spacing: 0.05em;
			}
			.nav-bar__mobile-lang .nav-bar__lang-current {
				color: rgba(255, 255, 255, 0.6);
			}
			.nav-bar__mobile-lang .nav-bar__lang-link {
				color: #ffffff;
				padding: 0.25rem 0.5rem;
				border-radius: 4px;
			}
			.nav-bar__mobile-lang .nav-bar__lang-link:hover {
				background: rgba(255, 255, 255, 0.2);
			}
			@media (max-width: 900px) {
				.nav-bar__links {
					display: none;
				}
				.nav-bar__hamburger {
					display: flex;
				}
				.nav-bar__mobile-panel {
					display: none;
				}
				.nav-bar--menu-open .nav-bar__mobile-panel {
					display: flex;
				}
			}
			@media (min-width: 901px) {
				.nav-bar__mobile-panel {
					display: none !important;
				}
			}
		</style>
		<script>
			(function () {
				const header = document.getElementById('nav-bar');
				const hamburger = document.getElementById('nav-bar__hamburger');
				const panel = document.getElementById('nav-bar__mobile-panel');
				const mobileLinks = panel?.querySelectorAll('.nav-bar__mobile-link, .nav-bar__mobile-cta, .nav-bar__lang-link');
				function openMenu() {
					if (!header) return;
					header.classList.add('nav-bar--menu-open');
					hamburger?.setAttribute('aria-expanded', 'true');
					panel?.removeAttribute('hidden');
					document.body.style.overflow = 'hidden';
				}
				function closeMenu() {
					if (!header) return;
					header.classList.remove('nav-bar--menu-open');
					hamburger?.setAttribute('aria-expanded', 'false');
					panel?.setAttribute('hidden', '');
					document.body.style.overflow = '';
				}
				function toggleMenu() {
					if (header?.classList.contains('nav-bar--menu-open')) closeMenu();
					else openMenu();
				}
				hamburger?.addEventListener('click', toggleMenu);
				mobileLinks?.forEach((link) => link.addEventListener('click', closeMenu));
			})();
		</script>
	</body>
</html>
