---
export const prerender = false;
import { isAdminAuthenticated } from '../lib/auth';

const req = Astro.request;
const host = (req?.headers?.get?.('host') ?? '') || '';
const forwardedHost = (req?.headers?.get?.('x-forwarded-host') ?? '') || '';
const isAdminSubdomain =
	host.includes('admin.itdevtesting.com') ||
	forwardedHost.includes('admin.itdevtesting.com') ||
	host.startsWith('localhost');
if (!isAdminSubdomain) {
	return Astro.redirect('https://itdevtesting.com');
}

const isLoginPage = Astro.url.pathname === '/admin/login' || Astro.url.pathname === '/admin/login/';
if (!isLoginPage) {
	try {
		if (!isAdminAuthenticated(req)) {
			return Astro.redirect('/admin/login');
		}
	} catch {
		return Astro.redirect('/admin/login');
	}
}

interface Props {
	title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title} | Admin</title>
		<style is:global>
			* { box-sizing: border-box; }
			body { font-family: system-ui, sans-serif; margin: 0; background: #f5f5f5; color: #1a1a1a; }
			.admin-nav { background: #1d8299; color: #fff; padding: 0.75rem 1.5rem; display: flex; align-items: center; justify-content: space-between; }
			.admin-nav a { color: #fff; text-decoration: none; margin-right: 1rem; }
			.admin-nav a:hover { text-decoration: underline; }
			.admin-main { max-width: 900px; margin: 0 auto; padding: 1.5rem; }
			.admin-card { background: #fff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); padding: 1.25rem; margin-bottom: 1rem; }
			.admin-btn { display: inline-block; padding: 0.5rem 1rem; background: #1d8299; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-size: 0.9rem; text-decoration: none; }
			.admin-btn:hover { background: #176f82; }
			.admin-btn--danger { background: #c53030; }
			.admin-btn--danger:hover { background: #9b2c2c; }
			.admin-btn--secondary { background: #718096; }
			input, select { padding: 0.5rem; border: 1px solid #ccc; border-radius: 6px; font-size: 0.95rem; width: 100%; max-width: 320px; }
			label { display: block; margin-bottom: 0.25rem; font-weight: 600; font-size: 0.9rem; }
			.form-row { margin-bottom: 1rem; }
			table { width: 100%; border-collapse: collapse; }
			th, td { padding: 0.5rem; text-align: left; border-bottom: 1px solid #eee; }
			th { font-weight: 600; color: #1d8299; }
			input[type="number"].cell-input { width: 4rem; padding: 0.35rem; text-align: right; }
		</style>
	</head>
	<body>
		{!isLoginPage && (
			<nav class="admin-nav">
				<div>
					<a href="/admin">Admin</a>
					<a href="/admin/locations">Locations</a>
					<a href="/admin/prices">Prices</a>
				</div>
				<form method="post" action="/api/admin-logout" style="display:inline">
					<button type="submit" class="admin-btn admin-btn--secondary">Logout</button>
				</form>
			</nav>
		)}
		<main class="admin-main">
			<slot />
		</main>
	</body>
</html>
