				font-weight: 600;
				color: #1a1a1a;
				margin-bottom: 0.25rem;
			}

			.booking-insurance__waiver {
				display: block;
				font-size: 0.85rem;
				color: #555;
				margin-bottom: 0.35rem;
			}

			.booking-insurance__price {
				color: #16a34a;
				font-weight: 600;
				margin-right: 0.35rem;
			}

			.booking-insurance__per-day {
				font-size: 0.8rem;
				color: #666;
			}

			.booking-insurance__checks {
				list-style: none;
				margin: 0.5rem 0 0;
				padding: 0;
				font-size: 0.85rem;
				color: #444;
			}

			.booking-insurance__checks li {
				margin-bottom: 0.2rem;
			}

			.booking-summary-card {
				background: #fff;
				border-radius: 10px;
				box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
				padding: 1.25rem;
			}

			.booking-summary__row {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 0.4rem;
				font-size: 0.95rem;
			}

			.booking-summary__row--indent {
				padding-left: 0.75rem;
			}

			.booking-summary__row--indent span:first-child {
				color: #555;
			}

			.booking-summary__base-price {
				font-weight: 600;
				color: #1d8299;
			}

			.booking-summary__subtext {
				margin: -0.2rem 0 0.75rem;
				font-size: 0.8rem;
				color: #666;
			}

			.booking-summary__total {
				margin-top: 1rem;
				padding-top: 0.75rem;
				border-top: 2px solid #eee;
				font-size: 1.05rem;
			}

			.booking-summary__total strong:last-child {
				color: #1d8299;
			}

			.booking-cta {
				display: block;
				width: 100%;
				margin-top: 1.25rem;
				padding: 0.9rem 1.5rem;
				background-color: #1d8299;
				color: #fff;
				text-align: center;
				font-weight: 600;
				text-decoration: none;
				border-radius: 8px;
				border: none;
				font-size: 1rem;
				transition: background-color 0.2s ease;
			}

			.booking-cta:hover {
				background-color: #176f82;
				color: #fff;
			}

			@media (max-width: 900px) {
				.nav-bar__links {
					display: none;
				}
			}
		</style>
		<script is:inline>
			(function () {
				const data = document.getElementById('booking-data');
				const basePrice = Number(data?.getAttribute('data-base-price')) || 0;
				const model = data?.getAttribute('data-model') || '';
				let pricesMatrix = [];
				let locationsList = [];
				try {
					const raw = data?.getAttribute('data-prices');
					if (raw) pricesMatrix = JSON.parse(raw);
					const locRaw = data?.getAttribute('data-locations');
					if (locRaw) locationsList = JSON.parse(locRaw);
				} catch (e) {}
				const insuranceEl = document.getElementById('summary-insurance');
				const locationsEl = document.getElementById('summary-locations');
				const insuranceTotalEl = document.getElementById('summary-insurance-total');
				const totalEl = document.getElementById('summary-total');
				const summaryDaysEl = document.getElementById('summary-days');
				const durationDaysEl = document.getElementById('duration-days');
				const pickupInput = document.getElementById('pickup-date');
				const returnInput = document.getElementById('return-date');
				const fullPrice = 10;
				const basicPrice = 0;

				function formatEur(n) {
					return '€' + n.toFixed(2);
				}

				function getSeason(dateStr) {
					var d = new Date(dateStr);
					var month = d.getMonth() + 1;
					var day = d.getDate();
					if (month < 6) return 'low';
					if (month > 9) return 'low';
					if (month === 6 && day < 15) return 'low';
					if (month === 9 && day > 30) return 'low';
					return 'high';
				}

				function getPriceFromMatrix(scooterId, season, days) {
					var row = pricesMatrix.find(function (p) {
						return p.scooter_id === scooterId && p.season === season && p.days === days;
					});
					return row ? Number(row.price_eur) : NaN;
				}

				function getDays() {
					if (!pickupInput?.value || !returnInput?.value) return null;
					var a = new Date(pickupInput.value);
					var b = new Date(returnInput.value);
					if (isNaN(a.getTime()) || isNaN(b.getTime()) || b < a) return null;
					var diff = Math.round((b - a) / (24 * 60 * 60 * 1000));
					return diff < 1 ? 1 : diff;
				}

				function setMinDates() {
					var today = new Date();
					today.setHours(0, 0, 0, 0);
					var todayStr = today.toISOString().slice(0, 10);
					if (pickupInput) {
						pickupInput.setAttribute('min', todayStr);
						if (pickupInput.value && returnInput) {
							returnInput.setAttribute('min', pickupInput.value);
						}
					}
				}

				function updateSummary() {
					var days = getDays();
					var radio = document.querySelector('input[name="insurance"]:checked');
					if (durationDaysEl) {
						durationDaysEl.textContent = days != null ? (days === 1 ? '1 Day' : days + ' Days') : '—';
					}
					if (summaryDaysEl) {
						summaryDaysEl.textContent = days != null ? String(days) : '—';
					}
					if (!insuranceEl || !insuranceTotalEl || !totalEl) return;
					if (days == null) {
						insuranceEl.textContent = '—';
						insuranceTotalEl.textContent = '—';
						totalEl.textContent = '—';
						return;
					}
					var value = radio?.value;
					var perDay = value === 'full' ? fullPrice : basicPrice;
					var insuranceTotal = perDay * days;
					var pickupLocId = document.getElementById('pickup-location')?.value || '';
					var returnLocId = document.getElementById('return-location')?.value || '';
					var locPrice = 0;
					locationsList.forEach(function (loc) {
						if (loc.id === pickupLocId && loc.price_eur != null) locPrice += Number(loc.price_eur);
						if (loc.id === returnLocId && loc.price_eur != null && returnLocId !== pickupLocId) locPrice += Number(loc.price_eur);
					});
					var season = pickupInput?.value ? getSeason(pickupInput.value) : 'high';
					var baseTotal;
					if (days <= 7) {
						var matrixPrice = getPriceFromMatrix(model, season, days);
						baseTotal = !isNaN(matrixPrice) ? matrixPrice : basePrice * days;
					} else {
						var price7 = getPriceFromMatrix(model, season, 7);
						if (!isNaN(price7) && price7 > 0) {
							var dailyRate = price7 / 7;
							var extraDays = days - 7;
							baseTotal = price7 + (dailyRate * extraDays);
						} else {
							baseTotal = basePrice * days;
						}
					}
					// Dynamic base price from matrix (1-day price for current season)
					var basePriceEl = document.querySelector('.booking-summary__base-price');
					var dayOnePrice = getPriceFromMatrix(model, season, 1);
					if (basePriceEl) basePriceEl.textContent = !isNaN(dayOnePrice) ? formatEur(dayOnePrice) : formatEur(basePrice);
					var total = baseTotal + insuranceTotal + locPrice;
					insuranceEl.textContent = formatEur(perDay);
					insuranceTotalEl.textContent = formatEur(insuranceTotal);
					if (locationsEl) locationsEl.textContent = formatEur(locPrice);
					totalEl.textContent = formatEur(total);
				}

				setMinDates();
				if (pickupInput) {
					pickupInput.addEventListener('change', function () {
						if (returnInput && this.value) returnInput.setAttribute('min', this.value);
						updateSummary();
					});
				}
				if (returnInput) {
					returnInput.addEventListener('change', updateSummary);
				}
				document.getElementById('pickup-location')?.addEventListener('change', updateSummary);
				document.getElementById('return-location')?.addEventListener('change', updateSummary);
				document.querySelectorAll('input[name="insurance"]').forEach(function (input) {
					input.addEventListener('change', updateSummary);
				});
			})();
		</script>
	</body>
</html>
