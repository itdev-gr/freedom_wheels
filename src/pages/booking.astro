---
export const prerender = false;

const title = 'Request a booking | Freedom Wheels – Scooter Rental Chania';
const description = 'Send your scooter rental booking request to Freedom Wheels in Chania. We\'ll confirm availability and price by email or phone.';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/logos/logo.webp', Astro.site).href;

const SCOOTERS: Record<string, { image: string; title: string; subtitle: string; basePricePerDay: number }> = {
	'sh-125': { image: '/images/sh-125.png', title: 'HONDA SH 125 2024', subtitle: 'SH 125', basePricePerDay: 35 },
	'liberty-125': { image: '/images/liberty-125.png', title: 'PIAGGIO LIBERTY 125 2025', subtitle: 'LIBERTY 125', basePricePerDay: 35 },
	'sim-200': { image: '/images/sim-200.png', title: 'SYM SIM 200 2025', subtitle: 'SIM 200', basePricePerDay: 45 },
	'voge-rally-300': { image: '/images/voge-rally-300.png', title: 'VOGE RALLY 300 2024', subtitle: 'VOGE RALLY 300', basePricePerDay: 55 },
};
const modelParam = Astro.url.searchParams.get('model') ?? 'liberty-125';
const scooter = SCOOTERS[modelParam] ?? SCOOTERS['liberty-125'];

let locations: Array<{ id: string; slug: string; label: string; sort_order: number; price_eur?: number | null }> = [];
let pricesMatrix: Array<{ scooter_id: string; season: string; days: number; price_eur: number }> = [];
try {
	const base = Astro.url.origin;
	const [locRes, priceRes] = await Promise.all([
		fetch(`${base}/api/locations`),
		fetch(`${base}/api/prices`),
	]);
	if (locRes.ok) locations = await locRes.json();
	if (priceRes.ok) pricesMatrix = await priceRes.json();
} catch {
	// fallback to hardcoded below
}
if (locations.length === 0) {
	locations = [
		{ id: 'chania-store', slug: 'chania-store', label: 'Chania – Freedom Wheels (7 Apokoronou Str)', sort_order: 0 },
		{ id: 'chania-port', slug: 'chania-port', label: 'Chania – Port', sort_order: 1 },
		{ id: 'chania-airport', slug: 'chania-airport', label: 'Chania – Airport', sort_order: 2 },
		{ id: 'other', slug: 'other', label: 'Other (specify in contact)', sort_order: 3 },
	];
}
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="el_GR" />
