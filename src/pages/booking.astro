							<img src={scooter.image} alt={scooter.title} class="booking-scooter__img" />
							<h1 class="booking-scooter__title">{scooter.title}</h1>
							<p class="booking-scooter__subtitle">{scooter.subtitle}</p>
							<div class="booking-scooter__dates">
								<div class="booking-date-row">
									<label for="pickup-date">Pick-up date</label>
									<input type="date" id="pickup-date" name="pickup-date" class="booking-date-input" />
								</div>
								<div class="booking-date-row">
									<label for="return-date">Return date</label>
									<input type="date" id="return-date" name="return-date" class="booking-date-input" />
								</div>
								<div class="booking-scooter__duration">
									<strong>Rental duration</strong>
									<span id="duration-days">—</span>
								</div>
							</div>
							<ul class="booking-scooter__features" aria-label="Features">
								<li>Manual</li>
								<li>Electric Start</li>
								<li>ABS</li>
								<li>Suspension System</li>
								<li>Storage Space</li>
								<li>Speedometer</li>
								<li>Odometer</li>
							</ul>
						</div>
					</div>

					<!-- Column 2: Pick-up & return location -->
					<div class="booking-col booking-col--location">
						<h2 class="booking-heading">Location</h2>
						<div class="booking-location-card">
							<div class="booking-date-row">
								<label for="pickup-location">Pick-up location</label>
								<select id="pickup-location" name="pickup-location" class="booking-select">
									<option value="">Select location</option>
									{locations.map((loc) => (
										<option value={loc.slug}>{loc.label}</option>
									))}
								</select>
							</div>
							<div class="booking-date-row">
								<label for="return-location">Return location</label>
								<select id="return-location" name="return-location" class="booking-select">
									<option value="">Select location</option>
									{locations.map((loc) => (
										<option value={loc.slug}>{loc.label}</option>
									))}
								</select>
							</div>
						</div>
					</div>

					<!-- Column 3: Price summary -->
					<div class="booking-col booking-col--summary">
						<h2 class="booking-heading">Price summary</h2>
						<div class="booking-summary-card">
							<div class="booking-summary__row">
								<span>Base price</span>
								<span class="booking-summary__base-price">—</span>
							</div>
							<p class="booking-summary__subtext">Rental per day</p>
							<div class="booking-summary__row">
								<span>Add-ons:</span>
							</div>
							<div class="booking-summary__row booking-summary__row--indent">
								<span>Equipment per day</span>
								<span>€0.00</span>
							</div>
							<div class="booking-summary__row booking-summary__row--indent">
								<span>Insurance per day</span>
								<span id="summary-insurance" data-full="10" data-basic="0">—</span>
							</div>
							<div class="booking-summary__row">
								<span>Total:</span>
							</div>
							<div class="booking-summary__row booking-summary__row--indent">
								<span>Number of days</span>
								<span id="summary-days">1</span>
							</div>
							<div class="booking-summary__row booking-summary__row--indent">
								<span>Equipment</span>
								<span>€0.00</span>
							</div>
							<div class="booking-summary__row booking-summary__row--indent">
								<span>Insurance</span>
								<span id="summary-insurance-total">—</span>
							</div>
							<div class="booking-summary__row booking-summary__row--indent">
								<span>Locations</span>
								<span id="summary-locations">€0.00</span>
							</div>
							<div class="booking-summary__row booking-summary__total">
								<strong>Total price</strong>
								<strong id="summary-total">—</strong>
							</div>
							<div id="booking-data" data-base-price={scooter.basePricePerDay} data-days="1" data-model={modelParam} data-prices={JSON.stringify(pricesMatrix)} data-locations={JSON.stringify(locations)} hidden></div>
							<a href={`/contact?model=${modelParam}`} class="booking-cta">Payment upon pickup</a>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="site-footer__inner">
				<div class="site-footer__col site-footer__company">
					<div class="site-footer__logo">
						<img src="/logos/logo.webp" alt="Freedom Wheels" class="site-footer__logo-img" />
						<span class="site-footer__name">FREEDOM WHEELS</span>
					</div>
					<ul class="site-footer__contact">
						<li>
							<span class="site-footer__icon" aria-hidden="true">📍</span>
							<span>7 Apokoronou Str, 73100 Chania, Crete, Greece</span>
						</li>
						<li>
							<span class="site-footer__icon" aria-hidden="true">📞</span>
							<a href="tel:+302821405794">+30 2821 405 794</a>
						</li>
						<li>
							<span class="site-footer__icon" aria-hidden="true">✉️</span>
							<a href="mailto:info@freedomwheels.gr">info@freedomwheels.gr</a>
						</li>
						<li><span>Αρ. ΓΕΜΗ: —</span></li>
					</ul>
				</div>
				<div class="site-footer__col site-footer__links">
					<h3 class="site-footer__heading">Σχετικά</h3>
					<ul>
						<li><a href="/#terms">Όροι Σύμβασης Μίσθωσης</a></li>
						<li><a href="/#policy">Πολιτική Κρατήσεων - Ακυρώσεων</a></li>
						<li><a href="/#cookies">Πολιτική Cookies</a></li>
						<li><a href="/#terms-use">Όροι Χρήσης</a></li>
						<li><a href="/#privacy">Πολιτική Απορρήτου</a></li>
						<li><a href="/#payment">Τρόποι Πληρωμής</a></li>
						<li><a href="/contact">Επικοινωνία</a></li>
					</ul>
				</div>
				<div class="site-footer__col site-footer__hours">
