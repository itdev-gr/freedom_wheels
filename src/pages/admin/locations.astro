---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';

const apiBase = Astro.url.origin;
let locations: Array<{ id: string; slug: string; label: string; sort_order: number }> = [];
try {
	const r = await fetch(`${apiBase}/api/locations`);
	if (r.ok) locations = await r.json();
} catch {
	// ignore
}
---
<AdminLayout title="Locations">
	<div class="admin-card">
		<h1 style="margin:0 0 1rem">Pick-up & return locations</h1>
		<p style="margin:0 0 1rem">These appear in the booking page dropdowns. Same list for pick-up and return.</p>
		<button type="button" class="admin-btn" id="btn-add">Add location</button>
	</div>

	<div class="admin-card">
		<table>
			<thead>
				<tr>
					<th>Slug</th>
					<th>Label</th>
					<th>Order</th>
					<th></th>
				</tr>
			</thead>
			<tbody id="locations-tbody">
				{locations.map((loc) => (
					<tr data-id={loc.id}>
						<td>{loc.slug}</td>
						<td>{loc.label}</td>
						<td>{loc.sort_order}</td>
						<td>
							<button type="button" class="admin-btn admin-btn--secondary edit-btn" data-id={loc.id} data-slug={loc.slug} data-label={loc.label} data-sort={loc.sort_order}>Edit</button>
							<button type="button" class="admin-btn admin-btn--danger delete-btn" data-id={loc.id}>Delete</button>
						</td>
					</tr>
				))}
			</tbody>
		</table>
		{locations.length === 0 && (
			<p id="empty-msg">No locations yet. Add one or run the seed.</p>
		)}
	</div>

	<div id="modal" class="modal" hidden>
		<div class="modal-content">
			<h2 id="modal-title">Add location</h2>
			<form id="form">
				<input type="hidden" id="form-id" />
				<div class="form-row">
					<label for="form-slug">Slug (e.g. chania-store)</label>
					<input type="text" id="form-slug" required />
				</div>
				<div class="form-row">
					<label for="form-label">Label (display text)</label>
					<input type="text" id="form-label" required />
				</div>
				<div class="form-row">
					<label for="form-sort">Sort order</label>
					<input type="number" id="form-sort" value="0" min="0" />
				</div>
				<button type="submit" class="admin-btn">Save</button>
				<button type="button" class="admin-btn admin-btn--secondary" id="modal-cancel">Cancel</button>
			</form>
		</div>
	</div>

	<style>
		.modal { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 10; }
		.modal-content { background: #fff; padding: 1.5rem; border-radius: 8px; width: 100%; max-width: 400px; }
		.modal h2 { margin: 0 0 1rem; font-size: 1.1rem; }
		.delete-btn { margin-left: 0.5rem; }
	</style>
	<script define:vars={{ apiBase: apiBase }}>
		const tbody = document.getElementById('locations-tbody');
		const emptyMsg = document.getElementById('empty-msg');
		const modal = document.getElementById('modal');
		const modalTitle = document.getElementById('modal-title');
		const form = document.getElementById('form');
		const formId = document.getElementById('form-id');
		const formSlug = document.getElementById('form-slug');
		const formLabel = document.getElementById('form-label');
		const formSort = document.getElementById('form-sort');

		function showModal(edit = null) {
			modal?.removeAttribute('hidden');
			if (edit) {
				modalTitle.textContent = 'Edit location';
				formId.value = edit.id;
				formSlug.value = edit.slug;
				formSlug.readOnly = true;
				formLabel.value = edit.label;
				formSort.value = edit.sort_order;
			} else {
				modalTitle.textContent = 'Add location';
				formId.value = '';
				formSlug.value = '';
				formSlug.readOnly = false;
				formLabel.value = '';
				formSort.value = '0';
			}
		}

		function hideModal() {
			modal?.setAttribute('hidden', '');
		}

		document.getElementById('btn-add')?.addEventListener('click', () => showModal());
		document.getElementById('modal-cancel')?.addEventListener('click', hideModal);

		tbody?.querySelectorAll('.edit-btn').forEach((btn) => {
			btn.addEventListener('click', () => {
				showModal({
					id: btn.dataset.id,
					slug: btn.dataset.slug,
					label: btn.dataset.label,
					sort_order: btn.dataset.sort,
				});
			});
		});

		tbody?.querySelectorAll('.delete-btn').forEach((btn) => {
			btn.addEventListener('click', async () => {
				if (!confirm('Delete this location?')) return;
				const id = btn.dataset.id;
				const res = await fetch(`${apiBase}/api/locations?id=${encodeURIComponent(id)}`, { method: 'DELETE', credentials: 'include' });
				if (res.ok) window.location.reload();
				else alert('Delete failed');
			});
		});

		form?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const id = formId.value.trim();
			const slug = formSlug.value.trim();
			const label = formLabel.value.trim();
			const sort_order = parseInt(formSort.value, 10) || 0;
			if (!slug || !label) return;
			const isEdit = !!id;
			const url = `${apiBase}/api/locations`;
			const res = await fetch(url, {
				method: isEdit ? 'PUT' : 'POST',
				headers: { 'Content-Type': 'application/json' },
				credentials: 'include',
				body: JSON.stringify(isEdit ? { id, slug, label, sort_order } : { slug, label, sort_order }),
			});
			if (res.ok) window.location.reload();
			else alert((await res.json()).error || 'Save failed');
		});
	</script>
</AdminLayout>
