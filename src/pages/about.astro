---
const title = 'About Us | Freedom Wheels – Scooter Rental Chania';
const description = 'Freedom Wheels is your scooter rental in Chania, Crete. Learn who we are, why Chania is perfect for scooters, and what we offer. Reliable bikes, helmets, and local advice.';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/logos/logo.webp', Astro.site).href;
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="el_GR" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<link rel="icon" type="image/webp" href="/logos/logo.webp" />
		<link rel="apple-touch-icon" href="/logos/logo.webp" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header class="nav-bar nav-bar--scrolled" id="nav-bar">
			<div class="nav-bar__inner">
				<a href="/" class="logo">
					<img src="/logos/logo.webp" alt="Freedom Wheels" class="logo__image" />
				</a>
				<nav class="nav-bar__links">
					<a href="/rentals" class="nav-bar__link">Rentals</a>
					<a href="/chania" class="nav-bar__link">Chania</a>
					<a href="/about" class="nav-bar__link nav-bar__link--active">About us</a>
					<a href="/contact" class="nav-bar__link">Contact</a>
					<a href="/book" class="nav-bar__cta">Book now</a>
				</nav>
			</div>
		</header>

		<main class="page">
			<section class="page-hero">
				<h1 class="page-hero__title">About Us</h1>
				<p class="page-hero__subtitle">Your scooter rental partner in Chania, Crete</p>
			</section>

			<section class="page-content">
				<div class="page-content__inner">
					<h2 class="page-content__heading">Who we are</h2>
					<p>Freedom Wheels is a scooter rental company based in Chania, on the island of Crete. We focus on one thing: giving you a reliable, well-maintained scooter so you can explore the city and the surrounding area at your own pace.</p>

					<h2 class="page-content__heading">Why Chania</h2>
					<p>Chania’s old town, Venetian harbour and narrow streets are perfect for two wheels. Parking is easy, traffic is manageable and you can reach beaches, villages and viewpoints without depending on buses or taxis. Whether you’re here for a few days or longer, a scooter is one of the best ways to experience the region.</p>

					<h2 class="page-content__heading">What we offer</h2>
					<p>We offer a range of scooters suited to solo riders and pairs. All our bikes are regularly serviced and we provide helmets. We’re happy to suggest routes, from short loops around the old town to longer trips along the coast or into the hills. Our goal is simple: safe, hassle-free rental and friendly local advice.</p>

					<div class="page-content__cta-wrap">
						<a href="/#rent" class="page-content__cta">Rent a Scooter Chania</a>
						<a href="/contact" class="page-content__cta page-content__cta--secondary">Contact us</a>
					</div>
				</div>
			</section>

		<footer class="site-footer">
			<div class="site-footer__inner">
				<div class="site-footer__col site-footer__company">
					<div class="site-footer__logo">
						<img src="/logos/logo.webp" alt="Freedom Wheels" class="site-footer__logo-img" />
						<span class="site-footer__name">FREEDOM WHEELS</span>
					</div>
					<ul class="site-footer__contact">
						<li>
							<span class="site-footer__icon" aria-hidden="true">📍</span>
							<span>7 Apokoronou Str, 73100 Chania, Crete, Greece</span>
						</li>
						<li>
							<span class="site-footer__icon" aria-hidden="true">📞</span>
							<a href="tel:+302821405794">+30 2821 405 794</a>
						</li>
						<li>
							<span class="site-footer__icon" aria-hidden="true">✉️</span>
							<a href="mailto:info@freedomwheels.gr">info@freedomwheels.gr</a>
						</li>
						<li><span>GEMI No.: —</span></li>
					</ul>
				</div>
				<div class="site-footer__col site-footer__links">
					<h3 class="site-footer__heading">About</h3>
					<ul>
						<li><a href="/#terms">Rental Terms</a></li>
						<li><a href="/#policy">Booking & Cancellation Policy</a></li>
						<li><a href="/#cookies">Cookie Policy</a></li>
						<li><a href="/#terms-use">Terms of Use</a></li>
						<li><a href="/#privacy">Privacy Policy</a></li>
						<li><a href="/#payment">Payment Methods</a></li>
						<li><a href="/contact">Contact</a></li>
					</ul>
				</div>
				<div class="site-footer__col site-footer__hours">
					<h3 class="site-footer__heading">Opening Hours</h3>
					<p class="site-footer__hours-text">Mon - Fri: 09:00 - 19:00</p>
					<p class="site-footer__hours-text">Sat: 09:00 - 14:00</p>
					<p class="site-footer__hours-text">Sun: Closed</p>
				</div>
			</div>
			<div class="site-footer__bottom">
				<p class="site-footer__copyright">Copyright 2026 © Freedom Wheels · Powered by <a href="https://www.itdev.gr/" target="_blank" rel="noopener noreferrer">IT DEV</a></p>
			</div>
		</footer>

		<style>
			:root {
				--font-heading: Georgia, 'Times New Roman', serif;
				--font-body: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				padding: 0;
				font-family: var(--font-body);
				background-color: #ffffff;
				color: #1a1a1a;
			}

			body {
				min-height: 100vh;
			}

			.page {
				padding-top: 70px;
			}

			/* Nav – solid on inner pages */
			.nav-bar {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 30;
				background-color: transparent;
				backdrop-filter: blur(8px);
				transition: background-color 200ms ease-out, box-shadow 200ms ease-out;
			}

			.nav-bar--scrolled {
				background-color: rgba(85, 83, 86, 0.5);
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
			}

			.nav-bar__inner {
				max-width: 1200px;
				margin: 0 auto;
				padding: 0.85rem 2rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 2rem;
			}

			.logo {
				display: inline-flex;
				align-items: center;
				gap: 0.65rem;
				color: #ffffff;
				text-decoration: none;
			}

			.logo__image {
				height: 48px;
				width: auto;
				display: block;
			}

			.logo__text {
				font-family: var(--font-body);
				font-size: 0.7rem;
				letter-spacing: 0.24em;
				text-transform: uppercase;
				white-space: nowrap;
				font-weight: 500;
			}

			.nav-bar__links {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
			}

			.nav-bar__link {
				font-family: var(--font-body);
				display: inline-block;
				padding: 0.5rem 1rem;
				border-radius: 999px;
				background-color: rgba(128, 128, 128, 0.85);
				color: #ffffff;
				font-size: 0.75rem;
				font-weight: 500;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				text-decoration: none;
				transition: background-color 150ms ease-out;
			}

			.nav-bar__link:hover,
			.nav-bar__link--active {
				background-color: rgba(100, 100, 100, 0.95);
				color: #ffffff;
			}

			.nav-bar__cta {
				font-family: var(--font-body);
				display: inline-block;
				padding: 0.5rem 1.25rem;
				border-radius: 999px;
				background-color: #1a1a1a;
				color: #ffffff;
				font-size: 0.75rem;
				font-weight: 600;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				text-decoration: none;
				transition: background-color 150ms ease-out;
			}

			.nav-bar__cta:hover {
				background-color: #333;
			}

			/* Page hero */
			.page-hero {
				background-color: #1d8299;
				color: #fff;
				text-align: center;
				padding: 3rem 2rem;
			}

			.page-hero__title {
				margin: 0 0 0.5rem;
				font-family: var(--font-heading);
				font-size: clamp(2rem, 4vw, 3rem);
				font-weight: 700;
			}

			.page-hero__subtitle {
				margin: 0;
				font-size: 1.1rem;
				opacity: 0.95;
			}

			/* Page content */
			.page-content {
				padding: 3rem 2rem 4rem;
			}

			.page-content__inner {
				max-width: 720px;
				margin: 0 auto;
			}

			.page-content__heading {
				font-family: var(--font-heading);
				font-size: 1.5rem;
				margin: 2rem 0 0.75rem;
				color: #1a1a1a;
			}

			.page-content__heading:first-child {
				margin-top: 0;
			}

			.page-content p {
				line-height: 1.7;
				margin: 0 0 1rem;
				color: #333;
			}

			.page-content__cta-wrap {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				margin-top: 2.5rem;
			}

			.page-content__cta {
				display: inline-block;
				padding: 0.75rem 1.75rem;
				border-radius: 6px;
				font-family: var(--font-body);
				font-size: 0.9rem;
				font-weight: 500;
				text-decoration: none;
				transition: background-color 160ms ease-out, border-color 160ms ease-out;
			}

			.page-content__cta:first-child {
				background-color: #1d8299;
				color: #fff;
				border: 1px solid #1d8299;
			}

			.page-content__cta:first-child:hover {
				background-color: #176b7d;
				border-color: #176b7d;
			}

			.page-content__cta--secondary {
				background-color: transparent;
				color: #1a1a1a;
				border: 1px solid #c4a574;
			}

			.page-content__cta--secondary:hover {
				background-color: #f5f0e6;
			}

			/* Footer */
			.site-footer {
				background-color: #1d8299;
				color: #fff;
				padding: 3rem 2rem 0;
				font-family: var(--font-body);
			}

			.site-footer__inner {
				max-width: 1200px;
				margin: 0 auto;
				display: flex;
				gap: 3rem;
				flex-wrap: wrap;
				padding-bottom: 2rem;
			}

			.site-footer__col {
				flex: 1 1 200px;
				min-width: 0;
			}

			.site-footer__company {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.site-footer__logo {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.site-footer__logo-img {
				height: 48px;
				width: auto;
				object-fit: contain;
			}

			.site-footer__name {
				font-size: 1.25rem;
				font-weight: 600;
				letter-spacing: 0.05em;
				color: #fff;
			}

			.site-footer__contact {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}

			.site-footer__contact li {
				display: flex;
				align-items: flex-start;
				gap: 0.5rem;
			}

			.site-footer__icon {
				flex-shrink: 0;
			}

			.site-footer__contact a,
			.site-footer__contact span {
				color: #fff;
				text-decoration: none;
				font-size: 0.95rem;
			}

			.site-footer__contact a:hover {
				text-decoration: underline;
			}

			.site-footer__heading {
				font-size: 1.1rem;
				font-weight: 600;
				margin: 0 0 1rem;
				color: #fff;
				letter-spacing: 0.02em;
			}

			.site-footer__links ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.site-footer__links li {
				margin-bottom: 0.4rem;
			}

			.site-footer__links a {
				color: #fff;
				text-decoration: none;
				font-size: 0.95rem;
			}

			.site-footer__links a:hover {
				text-decoration: underline;
			}

			.site-footer__hours-text {
				margin: 0 0 0.4rem;
				font-size: 0.95rem;
				color: #fff;
			}

			.site-footer__bottom {
				border-top: 1px solid rgba(255, 255, 255, 0.35);
				padding: 1rem 2rem;
				text-align: left;
			}

			.site-footer__copyright {
				margin: 0;
				font-size: 0.85rem;
				color: rgba(255, 255, 255, 0.85);
			}

			.site-footer__copyright a {
				color: rgba(255, 255, 255, 0.9);
				text-decoration: none;
			}

			.site-footer__copyright a:hover {
				text-decoration: underline;
			}

			@media (max-width: 900px) {
				.page-content__cta-wrap {
					flex-direction: column;
				}

				.site-footer__inner {
					flex-direction: column;
					gap: 2rem;
				}

				.nav-bar__links {
					display: none;
				}
			}
		</style>
	</body>
</html>
