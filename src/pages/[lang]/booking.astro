---
export const prerender = false;
import PublicLayout from '../../layouts/PublicLayout.astro';
import en from '../../locales/en';
import el from '../../locales/el';
import { getPrices, getLocations } from '../../lib/store';

const { lang } = Astro.params;
if (lang !== 'en' && lang !== 'el') {
	return Astro.redirect('/en');
}

const t = lang === 'el' ? el : en;

const SCOOTERS: Record<string, { image: string; title: string; subtitle: string }> = {
	'sh-125': { image: '/images/sh-125.png', title: 'HONDA SH 125 2024', subtitle: 'SH 125' },
	'liberty-125': { image: '/images/liberty-125.png', title: 'PIAGGIO LIBERTY 125 2025', subtitle: 'LIBERTY 125' },
	'sim-200': { image: '/images/sim-200.png', title: 'SYM SIM 200 2025', subtitle: 'SIM 200' },
	'voge-rally-300': { image: '/images/voge-rally-300.png', title: 'VOGE RALLY 300 2024', subtitle: 'VOGE RALLY 300' },
};
const modelParam = Astro.url.searchParams.get('model') ?? 'liberty-125';
const scooter = SCOOTERS[modelParam] ?? SCOOTERS['liberty-125'];

let locations: Array<{ id: string; slug: string; label: string; sort_order: number; price_eur?: number | null }> = [];
let pricesMatrix: Array<{ scooter_id: string; season: string; days: number; price_eur: number }> = [];
let loadedFromDb = false;
try {
	[locations, pricesMatrix] = await Promise.all([getLocations(), getPrices()]);
	loadedFromDb = locations.length > 0;
} catch {
	// fallback
}
// Only let the CDN cache this page when real catalog data loaded — never cache
// the degraded fallback (default locations, no prices) so the page self-heals
// the moment the backend is reachable again.
if (loadedFromDb) {
	Astro.response.headers.set('Cache-Control', 'public, s-maxage=120, stale-while-revalidate=600');
}
if (locations.length === 0) {
	locations = [
		{ id: 'chania-store', slug: 'chania-store', label: t.booking.locChaniaStore, sort_order: 0 },
		{ id: 'chania-port', slug: 'chania-port', label: t.booking.locChaniaPort, sort_order: 1 },
		{ id: 'chania-airport', slug: 'chania-airport', label: t.booking.locChaniaAirport, sort_order: 2 },
		{ id: 'other', slug: 'other', label: t.booking.locOther, sort_order: 3 },
	];
}

const site = Astro.site ?? new URL(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/logos/logo.webp', site).href;
---

<PublicLayout lang={lang} title={t.booking.title} description={t.booking.description} canonical={canonical} ogImage={ogImage} t={t}>
	<main class="page">
		<section class="booking-section">
			<div class="booking-grid">
				<div class="booking-col booking-col--scooter">
					<div class="booking-card booking-card--scooter">
						<img src={scooter.image} alt={scooter.title} class="booking-scooter__img" />
						<h1 class="booking-scooter__title">{scooter.title}</h1>
						<p class="booking-scooter__subtitle">{scooter.subtitle}</p>
						<ul class="booking-scooter__features" aria-label="Features">
							<li>{t.booking.featureManual}</li>
							<li>{t.booking.featureElectricStart}</li>
							<li>{t.booking.featureAbs}</li>
							<li>{t.booking.featureSuspension}</li>
							<li>{t.booking.featureStorage}</li>
							<li>{t.booking.featureSpeedometer}</li>
							<li>{t.booking.featureOdometer}</li>
						</ul>
					</div>
				</div>

				<div class="booking-col booking-col--location">
					<h2 class="booking-heading">{t.booking.location}</h2>
					<div class="booking-location-card">
						<div class="booking-date-row">
							<label for="pickup-location">{t.booking.pickupLocation}</label>
							<select id="pickup-location" name="pickup-location" class="booking-select">
								<option value="">{t.booking.selectLocation}</option>
								{locations.map((loc) => (
									<option value={loc.slug}>{loc.label}</option>
								))}
							</select>
						</div>
						<div class="booking-date-row">
							<label for="return-location">{t.booking.returnLocation}</label>
							<select id="return-location" name="return-location" class="booking-select">
								<option value="">{t.booking.selectLocation}</option>
								{locations.map((loc) => (
									<option value={loc.slug}>{loc.label}</option>
								))}
							</select>
						</div>
					</div>

					<h2 class="booking-heading">{t.booking.dates}</h2>
					<div class="booking-location-card">
						<div class="booking-date-row">
							<label for="pickup-date">{t.booking.pickupDate}</label>
							<input type="date" id="pickup-date" name="pickup-date" class="booking-date-input" />
						</div>
						<div class="booking-date-row">
							<label for="return-date">{t.booking.returnDate}</label>
							<input type="date" id="return-date" name="return-date" class="booking-date-input" />
						</div>
						<div class="booking-scooter__duration">
							<strong>{t.booking.rentalDuration}</strong>
							<span id="duration-days">—</span>
						</div>
					</div>
				</div>

				<div class="booking-col booking-col--summary">
					<h2 class="booking-heading">{t.booking.priceSummary}</h2>
					<div class="booking-summary-card">
						<div class="booking-summary__row">
							<span>{t.booking.basePrice}</span>
							<span class="booking-summary__base-price">—</span>
						</div>
						<p class="booking-summary__subtext">{t.booking.rentalPerDay}</p>
						<div class="booking-summary__row">
							<span>{t.booking.addOns}</span>
						</div>
						<div class="booking-summary__row booking-summary__row--indent">
							<span>{t.booking.equipmentPerDay}</span>
							<span>€0.00</span>
						</div>
						<div class="booking-summary__row booking-summary__row--indent">
							<span>{t.booking.insurancePerDay}</span>
							<span id="summary-insurance" data-full="10" data-basic="0">—</span>
						</div>
						<div class="booking-summary__row">
							<span>{t.booking.total}</span>
						</div>
						<div class="booking-summary__row booking-summary__row--indent">
							<span>{t.booking.numberOfDays}</span>
							<span id="summary-days">1</span>
						</div>
						<div class="booking-summary__row booking-summary__row--indent">
							<span>{t.booking.equipment}</span>
							<span>€0.00</span>
						</div>
						<div class="booking-summary__row booking-summary__row--indent">
							<span>{t.booking.insurance}</span>
							<span id="summary-insurance-total">—</span>
						</div>
						<div class="booking-summary__row booking-summary__row--indent">
							<span>{t.booking.locations}</span>
							<span id="summary-locations">€0.00</span>
						</div>
						<div class="booking-summary__row booking-summary__total">
							<strong>{t.booking.totalPrice}</strong>
							<strong id="summary-total">—</strong>
						</div>
						<div id="booking-data" data-days="1" data-model={modelParam} data-scooter-title={scooter.title} data-prices={JSON.stringify(pricesMatrix)} data-locations={JSON.stringify(locations)} data-lang={lang} data-i18n-day={t.booking.dayUnit} data-i18n-days={t.booking.daysUnit} data-i18n-alert-fill={t.booking.alertFillAll} data-i18n-alert-dates={t.booking.alertValidDates} hidden></div>
						<button type="button" id="continue-booking-btn" class="booking-cta">{t.booking.continueBooking}</button>
					</div>
				</div>
			</div>
		</section>
	</main>

	<style is:global>
		.page { padding-top: 70px; }
		.booking-section {
			background-color: #f5f5f5;
			padding: 2rem 1.5rem;
			min-height: 60vh;
		}
		.booking-grid {
			max-width: 1200px;
			margin: 0 auto;
			display: grid;
			grid-template-columns: 1.2fr 1fr 1fr;
			gap: 1.5rem;
			align-items: start;
		}
		@media (max-width: 900px) {
			.booking-grid { grid-template-columns: 1fr; }
		}
		.booking-col--scooter,
		.booking-col--location,
		.booking-col--summary { min-width: 0; }
		.booking-heading {
			color: #1d8299;
			font-size: 1.35rem;
			font-weight: 700;
			margin: 0 0 0.5rem;
		}
		.booking-location-card,
		.booking-card {
			background: #fff;
			border-radius: 10px;
			box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
			padding: 1.25rem;
		}
		.booking-card--scooter { text-align: center; }
		.booking-scooter__img {
			width: 100%;
			max-width: 280px;
			height: auto;
			object-fit: contain;
			border-radius: 8px;
			margin-bottom: 1rem;
		}
		.booking-scooter__title {
			color: #1d8299;
			font-size: 1.15rem;
			font-weight: 700;
			margin: 0 0 0.25rem;
		}
		.booking-scooter__subtitle {
			color: #666;
			font-size: 0.95rem;
			margin: 0 0 1rem;
		}
		.booking-date-row { margin-bottom: 0.75rem; }
		.booking-date-row label {
			display: block;
			font-size: 0.9rem;
			font-weight: 600;
			color: #333;
			margin-bottom: 0.35rem;
		}
		.booking-select,
		.booking-date-input {
			width: 100%;
			padding: 0.5rem 0.6rem;
			font-size: 0.95rem;
			border: 1px solid #ccc;
			border-radius: 6px;
			background: #fff;
			color: #1a1a1a;
		}
		.booking-select:focus,
		.booking-date-input:focus {
			outline: none;
			border-color: #1d8299;
			box-shadow: 0 0 0 2px rgba(29, 130, 153, 0.2);
		}
		.booking-scooter__duration {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 0.5rem 0;
			margin-top: 0.5rem;
			border-top: 1px solid #eee;
			border-bottom: 1px solid #eee;
			font-size: 0.95rem;
		}
		.booking-scooter__features {
			list-style: none;
			margin: 0;
			padding: 0;
			text-align: left;
			font-size: 0.9rem;
			color: #444;
		}
		.booking-scooter__features li {
			padding: 0.25rem 0;
			padding-left: 1.25rem;
			position: relative;
		}
		.booking-scooter__features li::before {
			content: '⚙';
			position: absolute;
			left: 0;
			font-size: 0.8rem;
		}
		.booking-summary__row {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 0.4rem;
			font-size: 0.95rem;
		}
		.booking-summary__row--indent { padding-left: 0.75rem; }
		.booking-summary__row--indent span:first-child { color: #555; }
		.booking-summary__base-price { font-weight: 600; color: #1d8299; }
		.booking-summary__subtext {
			margin: -0.2rem 0 0.75rem;
			font-size: 0.8rem;
			color: #666;
		}
		.booking-summary__total {
			margin-top: 1rem;
			padding-top: 0.75rem;
			border-top: 2px solid #eee;
			font-size: 1.05rem;
		}
		.booking-summary__total strong:last-child { color: #1d8299; }
		.booking-cta {
			display: block;
			width: 100%;
			margin-top: 1.25rem;
			padding: 0.9rem 1.5rem;
			background-color: #1d8299;
			color: #fff;
			text-align: center;
			font-weight: 600;
			border-radius: 8px;
			border: none;
			font-size: 1rem;
			transition: background-color 0.2s ease;
		}
		.booking-cta:hover { background-color: #176f82; color: #fff; }
	</style>

	<script is:inline>
		(function () {
			const data = document.getElementById('booking-data');
			const lang = data?.getAttribute('data-lang') || 'en';
			const model = data?.getAttribute('data-model') || '';
			var i18nDay = data?.getAttribute('data-i18n-day') || 'Day';
			var i18nDays = data?.getAttribute('data-i18n-days') || 'Days';
			var i18nAlertFill = data?.getAttribute('data-i18n-alert-fill') || 'Please fill in all dates and locations before continuing.';
			var i18nAlertDates = data?.getAttribute('data-i18n-alert-dates') || 'Please select valid pickup and return dates.';
			let pricesMatrix = [];
			let locationsList = [];
			try {
				const raw = data?.getAttribute('data-prices');
				if (raw) pricesMatrix = JSON.parse(raw);
				const locRaw = data?.getAttribute('data-locations');
				if (locRaw) locationsList = JSON.parse(locRaw);
			} catch (e) {}
			const insuranceEl = document.getElementById('summary-insurance');
			const locationsEl = document.getElementById('summary-locations');
			const insuranceTotalEl = document.getElementById('summary-insurance-total');
			const totalEl = document.getElementById('summary-total');
			const summaryDaysEl = document.getElementById('summary-days');
			const durationDaysEl = document.getElementById('duration-days');
			const pickupInput = document.getElementById('pickup-date');
			const returnInput = document.getElementById('return-date');
			const fullPrice = 10;
			const basicPrice = 0;

			function formatEur(n) {
				return '€' + n.toFixed(2);
			}

			function getSeason(dateStr) {
				var d = new Date(dateStr);
				var month = d.getMonth() + 1;
				var day = d.getDate();
				if (month < 6) return 'low';
				if (month > 9) return 'low';
				if (month === 6 && day < 15) return 'low';
				if (month === 9 && day > 30) return 'low';
				return 'high';
			}

			function getPriceFromMatrix(scooterId, season, days) {
				var row = pricesMatrix.find(function (p) {
					return p.scooter_id === scooterId && p.season === season && p.days === days;
				});
				return row ? Number(row.price_eur) : NaN;
			}

			function getDays() {
				if (!pickupInput?.value || !returnInput?.value) return null;
				var a = new Date(pickupInput.value);
				var b = new Date(returnInput.value);
				if (isNaN(a.getTime()) || isNaN(b.getTime()) || b < a) return null;
				var diff = Math.round((b - a) / (24 * 60 * 60 * 1000));
				return diff < 2 ? null : diff;
			}

			function addDays(dateStr, n) {
				var d = new Date(dateStr);
				d.setDate(d.getDate() + n);
				return d.toISOString().slice(0, 10);
			}

			function setMinDates() {
				var today = new Date();
				today.setHours(0, 0, 0, 0);
				var todayStr = today.toISOString().slice(0, 10);
				if (pickupInput) {
					pickupInput.setAttribute('min', todayStr);
					if (pickupInput.value && pickupInput.value < todayStr) pickupInput.value = '';
					if (pickupInput.value && returnInput) {
						var minReturn = addDays(pickupInput.value, 2);
						returnInput.setAttribute('min', minReturn);
						if (returnInput.value && returnInput.value < minReturn) returnInput.value = '';
					}
				}
			}

			function updateSummary() {
				var days = getDays();
				var radio = document.querySelector('input[name="insurance"]:checked');
				if (durationDaysEl) {
					durationDaysEl.textContent = days != null ? (days === 1 ? '1 ' + i18nDay : days + ' ' + i18nDays) : '—';
				}
				if (summaryDaysEl) summaryDaysEl.textContent = days != null ? String(days) : '—';
				if (!insuranceEl || !insuranceTotalEl || !totalEl) return;
				if (days == null) {
					insuranceEl.textContent = '—';
					insuranceTotalEl.textContent = '—';
					totalEl.textContent = '—';
					return;
				}
				var value = radio?.value;
				var perDay = value === 'full' ? fullPrice : basicPrice;
				var insuranceTotal = perDay * days;
				var pickupLocId = document.getElementById('pickup-location')?.value || '';
				var returnLocId = document.getElementById('return-location')?.value || '';
				var locPrice = 0;
				locationsList.forEach(function (loc) {
					if (loc.price_eur == null) return;
					if (loc.id === pickupLocId || loc.slug === pickupLocId) locPrice += Number(loc.price_eur);
					if (loc.id === returnLocId || loc.slug === returnLocId) locPrice += Number(loc.price_eur);
				});
				var season = pickupInput?.value ? getSeason(pickupInput.value) : 'high';
				var baseTotal = NaN;
				if (days <= 7) {
					var matrixPrice = getPriceFromMatrix(model, season, days);
					if (!isNaN(matrixPrice)) baseTotal = matrixPrice;
				} else {
					var price7 = getPriceFromMatrix(model, season, 7);
					if (!isNaN(price7) && price7 > 0) {
						var dailyRate = price7 / 7;
						var extraDays = days - 7;
						baseTotal = price7 + (dailyRate * extraDays);
					}
				}
				var basePriceEl = document.querySelector('.booking-summary__base-price');
				var dayOnePrice = getPriceFromMatrix(model, season, 1);
				if (basePriceEl) basePriceEl.textContent = !isNaN(dayOnePrice) ? formatEur(dayOnePrice) : '—';
				var total = (isNaN(baseTotal) ? NaN : baseTotal + insuranceTotal + locPrice);
				insuranceEl.textContent = formatEur(perDay);
				insuranceTotalEl.textContent = formatEur(insuranceTotal);
				if (locationsEl) locationsEl.textContent = formatEur(locPrice);
				totalEl.textContent = isNaN(total) ? '—' : formatEur(total);
			}

			setMinDates();
			if (pickupInput) {
				pickupInput.addEventListener('change', function () {
					if (returnInput && this.value) {
						var minReturn = addDays(this.value, 2);
						returnInput.setAttribute('min', minReturn);
						if (returnInput.value && returnInput.value < minReturn) returnInput.value = '';
					}
					updateSummary();
				});
			}
			if (returnInput) returnInput.addEventListener('change', updateSummary);
			document.getElementById('pickup-location')?.addEventListener('change', updateSummary);
			document.getElementById('return-location')?.addEventListener('change', updateSummary);
			document.querySelectorAll('input[name="insurance"]').forEach(function (input) {
				input.addEventListener('change', updateSummary);
			});

			var continueBtn = document.getElementById('continue-booking-btn');
			if (continueBtn) {
				continueBtn.addEventListener('click', function () {
					var pickupLoc = document.getElementById('pickup-location');
					var returnLoc = document.getElementById('return-location');
					if (!pickupInput?.value || !returnInput?.value || !pickupLoc?.value || !returnLoc?.value) {
						alert(i18nAlertFill);
						return;
					}
					var days = getDays();
					if (days == null || days < 1) {
						alert(i18nAlertDates);
						return;
					}
					var totalText = totalEl?.textContent || '';
					var totalNum = parseFloat(totalText.replace('€', '')) || 0;
					var pickupLabel = '';
					var returnLabel = '';
					locationsList.forEach(function (loc) {
						if (loc.slug === pickupLoc.value || loc.id === pickupLoc.value) pickupLabel = loc.label;
						if (loc.slug === returnLoc.value || loc.id === returnLoc.value) returnLabel = loc.label;
					});
					var bookingData = {
						model: model,
						scooterTitle: data?.getAttribute('data-scooter-title') || '',
						pickupDate: pickupInput.value,
						returnDate: returnInput.value,
						pickupLocation: pickupLoc.value,
						pickupLocationLabel: pickupLabel,
						returnLocation: returnLoc.value,
						returnLocationLabel: returnLabel,
						totalDays: days,
						totalEur: totalNum
					};
					localStorage.setItem('fw_checkout', JSON.stringify(bookingData));
					window.location.href = '/' + lang + '/checkout';
				});
			}
		})();
	</script>
</PublicLayout>
