---
import PublicLayout from '../../layouts/PublicLayout.astro';
import en from '../../locales/en';
import el from '../../locales/el';

export function getStaticPaths() {
	return [{ params: { lang: 'en' } }, { params: { lang: 'el' } }];
}

const { lang } = Astro.params;
if (lang !== 'en' && lang !== 'el') {
	return Astro.redirect('/en');
}

const t = lang === 'el' ? el : en;
const site = Astro.site ?? new URL(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/logos/logo.webp', site).href;
---

<PublicLayout lang={lang} title={t.contact.title} description={t.contact.description} canonical={canonical} ogImage={ogImage} t={t}>
	<main class="page">
		<h1 class="visually-hidden">{t.contact.pageTitle}</h1>
		<section class="contact-hero">
			<div class="contact-hero__overlay"></div>
			<div class="contact-hero__content">
				<div class="contact-cards">
					<div class="contact-card">
						<div class="contact-card__icon" aria-hidden="true">
							<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
						</div>
						<h3 class="contact-card__title">{t.contact.address}</h3>
						<p class="contact-card__text">{t.contact.addressText}</p>
					</div>
					<div class="contact-card">
						<div class="contact-card__icon" aria-hidden="true">
							<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
						</div>
						<h3 class="contact-card__title">{t.contact.openingHours}</h3>
						<p class="contact-card__text">{t.contact.openingHoursText}<br />{t.contact.openingHoursSat}<br />{t.contact.openingHoursSun}</p>
					</div>
					<div class="contact-card">
						<div class="contact-card__icon" aria-hidden="true">
							<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="m22 6-10 7L2 6"/></svg>
						</div>
						<h3 class="contact-card__title">{t.contact.emailAddress}</h3>
						<p class="contact-card__text"><a href="mailto:info@freedomwheels.gr">info@freedomwheels.gr</a></p>
					</div>
					<div class="contact-card">
						<div class="contact-card__icon" aria-hidden="true">
							<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
						</div>
						<h3 class="contact-card__title">{t.contact.contactPhone}</h3>
						<p class="contact-card__text"><a href="tel:+302821405794">+30 2821 405 794</a></p>
					</div>
				</div>
			</div>
		</section>

		<section class="contact-form-wrap">
			<div class="contact-form-wrap__inner">
				<div class="contact-form-section">
					<h2 class="contact-form-section__title">{t.contact.sendMessage}</h2>
					<form class="contact-form" id="contact-form" action="/api/contact" method="post">
						<div class="contact-form__row">
							<label class="contact-form__label" for="name">{t.contact.name} *</label>
							<input class="contact-form__input" id="name" name="name" type="text" required />
						</div>
						<div class="contact-form__row">
							<label class="contact-form__label" for="email">{t.contact.email} *</label>
							<input class="contact-form__input" id="email" name="email" type="email" required />
						</div>
						<div class="contact-form__row">
							<label class="contact-form__label" for="phone">{t.contact.phone}</label>
							<input class="contact-form__input" id="phone" name="phone" type="tel" />
						</div>
						<div class="contact-form__row">
							<label class="contact-form__label" for="message">{t.contact.message} *</label>
							<textarea class="contact-form__input contact-form__textarea" id="message" name="message" rows="5" required></textarea>
						</div>
						<button type="submit" class="contact-form__submit">{t.contact.send}</button>
							<p id="contact-status" class="contact-form__status" role="status" aria-live="polite" hidden></p>
					</form>
				</div>
				<div class="contact-map">
					<iframe
						title={t.contact.mapTitle}
						src="https://maps.google.com/maps?q=Apokoronou+7,+Chania+731+00,+Greece&t=&z=16&ie=UTF8&iwloc=&output=embed"
						width="100%"
						height="100%"
						style="border:0;"
						allowfullscreen=""
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
					></iframe>
				</div>
			</div>
		</section>
	</main>

	<style is:global>
		.page { padding-top: 70px; }
		.visually-hidden {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}
		.contact-hero {
			position: relative;
			height: 76.5vh;
			min-height: 76.5vh;
			background-image: url("/images/chania%20port.jpg");
			background-size: cover;
			background-position: center;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 0 1.5rem 4rem;
		}
		.contact-hero__overlay {
			position: absolute;
			inset: 0;
			background: rgba(0, 0, 0, 0.35);
		}
		.contact-hero__content {
			position: relative;
			z-index: 1;
			width: 100%;
			max-width: 900px;
			display: flex;
			flex-direction: column;
			align-items: center;
			transform: translateY(15.3vh);
		}
		.contact-cards {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 1.25rem;
			width: 100%;
			max-width: 1100px;
		}
		.contact-card {
			background: #fff;
			border-radius: 12px;
			padding: 1.5rem;
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
			transition: transform 0.25s ease-out, box-shadow 0.25s ease-out;
		}
		.contact-card:hover {
			transform: translateY(-4px);
			box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
		}
		.contact-card__icon { color: #ea580c; margin-bottom: 0.75rem; }
		.contact-card__title {
			font-size: 1rem;
			font-weight: 600;
			color: #2a9fb5;
			margin: 0 0 0.5rem;
		}
		.contact-card__text {
			font-size: 0.95rem;
			line-height: 1.5;
			color: #374151;
			margin: 0;
		}
		.contact-card__text a {
			color: #2a9fb5;
			text-decoration: none;
		}
		.contact-card__text a:hover { text-decoration: underline; }
		.contact-form-wrap {
			background: #f8f9fa;
			padding: 3rem 2rem 4rem;
		}
		.contact-form-wrap__inner {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
			max-width: 1200px;
			margin: 0 auto;
			align-items: start;
		}
		.contact-form-section {
			background: #fff;
			border-radius: 12px;
			padding: 2rem;
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
		}
		.contact-map {
			position: relative;
			width: 100%;
			min-height: 400px;
			background: #e5e7eb;
			border-radius: 12px;
			overflow: hidden;
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
		}
		.contact-map iframe {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			min-height: 400px;
		}
		.contact-form-section__title {
			font-size: 1.25rem;
			font-weight: 600;
			color: #2a9fb5;
			margin: 0 0 1.5rem;
		}
		.contact-form {
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}
		.contact-form__row {
			display: flex;
			flex-direction: column;
			gap: 0.35rem;
		}
		.contact-form__label {
			font-size: 0.9rem;
			font-weight: 500;
			color: #374151;
		}
		.contact-form__input {
			font-size: 1rem;
			padding: 0.65rem 0.85rem;
			border: 1px solid #d1d5db;
			border-radius: 8px;
			background: #fff;
			color: #1a1a1a;
			transition: border-color 0.2s ease, box-shadow 0.2s ease;
		}
		.contact-form__input:focus {
			outline: none;
			border-color: #2a9fb5;
			box-shadow: 0 0 0 3px rgba(42, 159, 181, 0.2);
		}
		.contact-form__textarea {
			resize: vertical;
			min-height: 120px;
		}
		.contact-form__submit {
			font-size: 0.95rem;
			font-weight: 600;
			color: #fff;
			background: #2a9fb5;
			border: none;
			border-radius: 8px;
			padding: 0.75rem 1.5rem;
			margin-top: 0.25rem;
			cursor: pointer;
			transition: background-color 0.25s ease-out, transform 0.2s ease-out;
		}
		.contact-form__submit:hover {
			background: #1f7a8c;
			transform: translateY(-1px);
		}
		@media (max-width: 900px) {
			.contact-cards { grid-template-columns: repeat(2, 1fr); }
			.contact-form-wrap__inner {
				grid-template-columns: 1fr;
				transform: translateY(15%);
			}
		}
		@media (max-width: 500px) {
			.contact-cards { grid-template-columns: 1fr; }
		}
		.contact-form__status {
			margin: 0.25rem 0 0;
			font-size: 0.9rem;
			padding: 0.6rem 0.85rem;
			border-radius: 8px;
		}
		.contact-form__status--ok { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
		.contact-form__status--err { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
	</style>

	<script is:inline define:vars={{ lang }}>
		(function () {
			var form = document.getElementById('contact-form');
			var statusEl = document.getElementById('contact-status');
			if (!form) return;
			var isEl = lang === 'el';
			var strings = {
				sending: isEl ? 'Αποστολή…' : 'Sending…',
				ok: isEl ? 'Ευχαριστούμε! Το μήνυμά σας στάλθηκε.' : 'Thanks! Your message has been sent.',
				err: isEl
					? 'Κάτι πήγε στραβά. Δοκιμάστε ξανά ή στείλτε μας email στο info@freedomwheels.gr.'
					: 'Something went wrong. Please try again or email us at info@freedomwheels.gr.',
			};
			function show(msg, ok) {
				if (!statusEl) return;
				statusEl.textContent = msg;
				statusEl.hidden = false;
				statusEl.classList.remove('contact-form__status--ok', 'contact-form__status--err');
				statusEl.classList.add(ok ? 'contact-form__status--ok' : 'contact-form__status--err');
			}
			form.addEventListener('submit', function (e) {
				e.preventDefault();
				var btn = form.querySelector('.contact-form__submit');
				var payload = {
					name: (document.getElementById('name') || {}).value || '',
					email: (document.getElementById('email') || {}).value || '',
					phone: (document.getElementById('phone') || {}).value || '',
					message: (document.getElementById('message') || {}).value || '',
				};
				if (btn) btn.disabled = true;
				show(strings.sending, true);
				fetch('/api/contact', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(payload),
				})
					.then(function (res) { return res.ok; })
					.then(function (success) {
						if (success) {
							show(strings.ok, true);
							form.reset();
						} else {
							show(strings.err, false);
						}
					})
					.catch(function () { show(strings.err, false); })
					.finally(function () { if (btn) btn.disabled = false; });
			});
		})();
	</script>
</PublicLayout>
