---
import PublicLayout from '../../layouts/PublicLayout.astro';
import en from '../../locales/en';
import el from '../../locales/el';

export function getStaticPaths() {
	return [{ params: { lang: 'en' } }, { params: { lang: 'el' } }];
}

const { lang } = Astro.params;
if (lang !== 'en' && lang !== 'el') {
	return Astro.redirect('/en');
}

const t = lang === 'el' ? el : en;
const site = Astro.site ?? new URL(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/logos/logo.webp', site).href;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	name: 'Freedom Wheels',
	description: t.home.description,
	url: site,
	image: ogImage,
	address: { '@type': 'PostalAddress', streetAddress: '7 Apokoronou Str', addressLocality: 'Chania', postalCode: '73100', addressRegion: 'Crete', addressCountry: 'GR' },
	telephone: '+30 2821 405 794',
	email: 'info@freedomwheels.gr',
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '19:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '14:00' },
	],
};
---

<PublicLayout lang={lang} title={t.home.title} description={t.home.description} canonical={canonical} ogImage={ogImage} t={t} headerScrolled={false}>
	<main class="hero">
		<div class="hero__media">
			<video
				class="hero__video"
				src="/videos/chania-scooter.mp4"
				autoplay
				muted
				loop
				playsinline
			></video>
			<div class="hero__overlay"></div>
		</div>

		<section class="hero__content">
			<div class="hero__headline">
				<h1 class="hero__title">
					{t.home.heroTitle} <span>{t.home.heroTitleAccent}</span>
				</h1>
				<div class="hero__divider"></div>
			</div>
			<p class="hero__subtitle">
				{t.home.subtitle}
			</p>
		</section>
	</main>

	<section class="rent-ebike">
		<div class="rent-ebike__inner">
			<div class="rent-ebike__image">
				<img src="/images/rent-a-scooter-athens.png" alt="Scooter rental by the sea" />
			</div>
			<div class="rent-ebike__content">
				<h2 class="rent-ebike__title">{t.home.aboutTitle}</h2>
				<div class="rent-ebike__body">
					<p>{t.home.aboutP1}</p>
					<p>{t.home.aboutP2}</p>
				</div>
				<a href={`/${lang}/rentals`} class="rent-ebike__cta">{t.home.ctaRent}</a>
			</div>
		</div>
	</section>

	<section class="sivota-rentals">
		<div class="sivota-rentals__inner">
			<div class="sivota-rentals__content">
				<h2 class="sivota-rentals__title">{t.home.discoverTitle}</h2>
				<div class="sivota-rentals__body">
					<p>{t.home.discoverP}</p>
				</div>
				<a href={`/${lang}/chania`} class="sivota-rentals__cta">{t.home.ctaDiscover}</a>
			</div>
			<div class="sivota-rentals__image">
				<img src="/images/rent-a-scooter-athens.png" alt="Discover Chania by scooter" />
			</div>
		</div>
	</section>

	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<style>
		:root {
			--font-heading: Georgia, 'Times New Roman', serif;
			--font-body: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
			--hero-text: #ffffff;
		}

		.hero {
			position: relative;
			min-height: 100vh;
			display: flex;
			flex-direction: column;
			align-items: stretch;
			justify-content: center;
			padding: 5.5rem 3rem 3rem;
			background-color: #ffffff;
			color: var(--hero-text);
			overflow: hidden;
		}

		.hero__media {
			position: absolute;
			inset: 0;
			overflow: hidden;
			z-index: 0;
		}

		.hero__video {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.hero__overlay {
			position: absolute;
			inset: 0;
			background: radial-gradient(
				circle at 50% 0%,
				rgba(255, 255, 255, 0.08),
				transparent 60%
			);
			mix-blend-mode: screen;
			pointer-events: none;
		}

		.hero__content {
			position: relative;
			z-index: 1;
			max-width: 960px;
			margin: 0 auto;
			flex: 1;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			text-align: center;
			gap: 0.5rem;
		}

		.hero__headline {
			display: inline-flex;
			flex-direction: column;
			align-items: stretch;
			text-align: center;
		}

		.hero__title {
			margin: 0;
			font-family: var(--font-heading);
			font-size: clamp(3.2rem, 5vw + 1.5rem, 4.6rem);
			font-weight: 700;
			letter-spacing: 0.02em;
			color: #ffffff;
			text-shadow:
				0 3px 8px rgba(0, 0, 0, 0.6),
				0 0 1px rgba(0, 0, 0, 0.8);
		}

		.hero__title span {
			font-weight: 800;
		}

		.hero__divider {
			width: 80%;
			max-width: 320px;
			height: 1px;
			margin: 0.75rem auto 0.75rem;
			background-color: rgba(255, 255, 255, 0.95);
		}

		.hero__subtitle {
			margin: 0;
			font-family: var(--font-body);
			font-size: 1.2rem;
			font-weight: 500;
			color: #ffffff;
			text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
		}

		.rent-ebike { margin: 0; padding: 0; overflow: hidden; }
		.rent-ebike__inner {
			width: 100%;
			margin: 0;
			padding: 0;
			display: flex;
			align-items: stretch;
			min-height: 480px;
		}
		.rent-ebike__image {
			flex: 0 0 50%;
			min-height: 480px;
			overflow: hidden;
		}
		.rent-ebike__image img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.rent-ebike__content {
			font-family: var(--font-body);
			flex: 0 0 50%;
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			padding: 3rem 3rem 3rem 2.5rem;
			background: #ffffff;
			color: #1a1a1a;
		}
		.rent-ebike__title {
			font-family: var(--font-heading);
			margin: 20% 0 1.5rem 0;
			font-size: 1.75rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.02em;
			color: #1a1a1a;
			line-height: 1.3;
		}
		.rent-ebike__body {
			flex: 1;
			margin: 0 0 1.5rem;
			max-width: 520px;
		}
		.rent-ebike__body p {
			margin: 0 0 1rem;
			font-size: 0.95rem;
			line-height: 1.6;
			color: #333;
		}
		.rent-ebike__body p:last-child { margin-bottom: 0; }
		.rent-ebike__cta {
			align-self: center;
			margin-top: 1.5rem;
			margin-bottom: 20%;
			padding: 0.75rem 2rem;
			border-radius: 6px;
			border: 1px solid #c4a574;
			background-color: #f5f0e6;
			color: #1a1a1a;
			font-size: 0.9rem;
			font-weight: 500;
			text-decoration: none;
			transition: background-color 160ms ease-out, border-color 160ms ease-out;
		}
		.rent-ebike__cta:hover {
			background-color: #ebe5d9;
			border-color: #b3956a;
		}

		.sivota-rentals { margin: 0; padding: 0; overflow: hidden; }
		.sivota-rentals__inner {
			width: 100%;
			margin: 0;
			padding: 0;
			display: flex;
			align-items: stretch;
			min-height: 520px;
		}
		.sivota-rentals__content {
			font-family: var(--font-body);
			flex: 0 0 50%;
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			padding: 3rem 2.5rem 3rem 3rem;
			background: #ffffff;
			color: #1a1a1a;
		}
		.sivota-rentals__title {
			font-family: var(--font-heading);
			margin: 20% 0 1.5rem 0;
			font-size: 1.6rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.02em;
			color: #1a1a1a;
			line-height: 1.3;
		}
		.sivota-rentals__body {
			flex: 1;
			margin: 0 0 1.5rem;
			max-width: 520px;
		}
		.sivota-rentals__body p {
			margin: 0 0 1rem;
			font-size: 0.95rem;
			line-height: 1.6;
			color: #333;
		}
		.sivota-rentals__body p:last-child { margin-bottom: 0; }
		.sivota-rentals__cta {
			align-self: center;
			margin-top: 1.5rem;
			margin-bottom: 20%;
			padding: 0.75rem 2rem;
			border-radius: 6px;
			border: 1px solid #c4a574;
			background-color: #f5f0e6;
			color: #1a1a1a;
			font-size: 0.9rem;
			font-weight: 500;
			text-decoration: none;
			transition: background-color 160ms ease-out, border-color 160ms ease-out;
		}
		.sivota-rentals__cta:hover {
			background-color: #ebe5d9;
			border-color: #b3956a;
		}
		.sivota-rentals__image {
			flex: 0 0 50%;
			min-height: 520px;
			overflow: hidden;
		}
		.sivota-rentals__image img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		@media (max-width: 900px) {
			.hero { padding-inline: 1.5rem; padding-top: 5rem; }
			.rent-ebike__inner { flex-direction: column; min-height: auto; }
			.rent-ebike__image { flex: 0 0 auto; min-height: 280px; }
			.rent-ebike__content { padding: 2rem 1.5rem; }
			.rent-ebike__title { font-size: 1.5rem; }
			.sivota-rentals__inner { flex-direction: column; min-height: auto; }
			.sivota-rentals__content { padding: 2rem 1.5rem; }
			.sivota-rentals__image { flex: 0 0 auto; min-height: 280px; }
			.sivota-rentals__title { font-size: 1.4rem; }
		}
	</style>

	<script>
		window.addEventListener('scroll', () => {
			const navBar = document.getElementById('nav-bar');
			if (!navBar) return;
			const hero = document.querySelector('.hero');
			const heroBottom = hero && 'offsetHeight' in hero ? (hero as HTMLElement).offsetHeight : window.innerHeight;
			if (window.scrollY >= heroBottom) {
				navBar.classList.add('nav-bar--scrolled');
			} else {
				navBar.classList.remove('nav-bar--scrolled');
			}
		});
	</script>
</PublicLayout>
