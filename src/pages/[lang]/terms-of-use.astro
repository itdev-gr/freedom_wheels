---
import PublicLayout from '../../layouts/PublicLayout.astro';
import en from '../../locales/en';
import el from '../../locales/el';

export function getStaticPaths() {
	return [{ params: { lang: 'en' } }, { params: { lang: 'el' } }];
}

const { lang } = Astro.params;
if (lang !== 'en' && lang !== 'el') {
	return Astro.redirect('/en');
}

const t = lang === 'el' ? el : en;
const site = Astro.site ?? new URL(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/logos/logo.webp', site).href;
---

<PublicLayout lang={lang} title={t.termsOfUse.title} description={t.termsOfUse.description} canonical={canonical} ogImage={ogImage} t={t}>
	<main class="page">
		<section class="legal-section">
			<h1 class="legal-page-title">{t.termsOfUse.pageTitle}</h1>
			<p class="legal-updated">{t.termsOfUse.lastUpdated}</p>

			<div class="legal-content">
				<div class="legal-item">
					<h2 class="legal-item__title">{t.termsOfUse.introTitle}</h2>
					<p class="legal-item__text">{t.termsOfUse.introText}</p>
				</div>
				<div class="legal-item">
					<h2 class="legal-item__title">{t.termsOfUse.companyTitle}</h2>
					<p class="legal-item__text">{t.termsOfUse.companyText}</p>
				</div>
				<div class="legal-item">
					<h2 class="legal-item__title">{t.termsOfUse.servicesTitle}</h2>
					<p class="legal-item__text">{t.termsOfUse.servicesText}</p>
				</div>
				<div class="legal-item">
					<h2 class="legal-item__title">{t.termsOfUse.eligibilityTitle}</h2>
					<p class="legal-item__text">{t.termsOfUse.eligibilityText}</p>
				</div>
				<div class="legal-item">
					<h2 class="legal-item__title">{t.termsOfUse.bookingsTitle}</h2>
					<p class="legal-item__text">{t.termsOfUse.bookingsText}</p>
				</div>
				<div class="legal-item">
					<h2 class="legal-item__title">{t.termsOfUse.accuracyTitle}</h2>
					<p class="legal-item__text">{t.termsOfUse.accuracyText}</p>
				</div>
				<div class="legal-item">
					<h2 class="legal-item__title">{t.termsOfUse.ipTitle}</h2>
					<p class="legal-item__text">{t.termsOfUse.ipText}</p>
				</div>
				<div class="legal-item">
					<h2 class="legal-item__title">{t.termsOfUse.userConductTitle}</h2>
					<p class="legal-item__text">{t.termsOfUse.userConductText}</p>
				</div>
				<div class="legal-item">
					<h2 class="legal-item__title">{t.termsOfUse.disclaimerTitle}</h2>
					<p class="legal-item__text">{t.termsOfUse.disclaimerText}</p>
				</div>
				<div class="legal-item">
					<h2 class="legal-item__title">{t.termsOfUse.liabilityTitle}</h2>
					<p class="legal-item__text">{t.termsOfUse.liabilityText}</p>
				</div>
				<div class="legal-item">
					<h2 class="legal-item__title">{t.termsOfUse.linksTitle}</h2>
					<p class="legal-item__text">{t.termsOfUse.linksText}</p>
				</div>
				<div class="legal-item">
					<h2 class="legal-item__title">{t.termsOfUse.lawTitle}</h2>
					<p class="legal-item__text">{t.termsOfUse.lawText}</p>
				</div>
				<div class="legal-item">
					<h2 class="legal-item__title">{t.termsOfUse.modificationsTitle}</h2>
					<p class="legal-item__text">{t.termsOfUse.modificationsText}</p>
				</div>
				<div class="legal-item">
					<h2 class="legal-item__title">{t.termsOfUse.contactTitle}</h2>
					<p class="legal-item__text">{t.termsOfUse.contactText}</p>
					<p class="legal-item__text">Email: info@freedomwheels.gr</p>
					<p class="legal-item__text">Phone: +30 2821 405 794</p>
				</div>
			</div>
		</section>
	</main>

	<style is:global>
		.page { padding-top: 70px; }
		.legal-section {
			max-width: 800px;
			margin: 0 auto;
			padding: 2.5rem 1.5rem 4rem;
		}
		.legal-page-title {
			color: #1d8299;
			font-size: 1.8rem;
			font-weight: 700;
			text-align: center;
			margin: 0 0 0.5rem;
		}
		.legal-updated {
			text-align: center;
			font-size: 0.9rem;
			color: #888;
			margin: 0 0 2rem;
		}
		.legal-content {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
		}
		.legal-item {
			padding-bottom: 1.5rem;
			border-bottom: 1px solid #e5e7eb;
		}
		.legal-item:last-child {
			border-bottom: none;
			padding-bottom: 0;
		}
		.legal-item__title {
			font-size: 1.1rem;
			font-weight: 700;
			color: #1a1a1a;
			margin: 0 0 0.5rem;
		}
		.legal-item__text {
			font-size: 0.95rem;
			line-height: 1.65;
			color: #444;
			margin: 0 0 0.5rem;
		}
		.legal-item__text:last-child { margin-bottom: 0; }
		.legal-item__list {
			margin: 0.5rem 0 0;
			padding: 0 0 0 1.25rem;
			list-style: disc;
		}
		.legal-item__list li {
			font-size: 0.95rem;
			line-height: 1.6;
			color: #444;
			margin-bottom: 0.35rem;
		}
		.legal-item__list li:last-child { margin-bottom: 0; }
		@media (max-width: 600px) {
			.legal-section { padding: 1.5rem 1rem 3rem; }
		}
	</style>
</PublicLayout>
