---
import PublicLayout from '../../layouts/PublicLayout.astro';
import en from '../../locales/en';
import el from '../../locales/el';

export function getStaticPaths() {
	return [{ params: { lang: 'en' } }, { params: { lang: 'el' } }];
}

const { lang } = Astro.params;
if (lang !== 'en' && lang !== 'el') {
	return Astro.redirect('/en');
}

const t = lang === 'el' ? el : en;
const site = Astro.site ?? new URL(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/logos/logo.webp', site).href;
---

<PublicLayout lang={lang} title={t.about.title} description={t.about.description} canonical={canonical} ogImage={ogImage} t={t}>
	<main class="page" aria-label="About"></main>
	<style is:global>
		.page { padding-top: 70px; min-height: 40vh; }
	</style>
</PublicLayout>
