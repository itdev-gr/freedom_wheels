---
import PublicLayout from '../../layouts/PublicLayout.astro';
import en from '../../locales/en';
import el from '../../locales/el';

export function getStaticPaths() {
	return [{ params: { lang: 'en' } }, { params: { lang: 'el' } }];
}

const { lang } = Astro.params;
if (lang !== 'en' && lang !== 'el') {
	return Astro.redirect('/en');
}

const t = lang === 'el' ? el : en;
const site = Astro.site ?? new URL(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/logos/logo.webp', site).href;
---

<PublicLayout lang={lang} title={t.about.title} description={t.about.description} canonical={canonical} ogImage={ogImage} t={t}>
	<main class="page">
		<section class="page-hero">
			<h1 class="page-hero__title">{t.about.pageTitle}</h1>
			<p class="page-hero__subtitle">{t.about.subtitle}</p>
		</section>

		<section class="page-content">
			<div class="page-content__inner">
				<h2 class="page-content__heading">{t.about.whoWeAre}</h2>
				<p>{t.about.whoWeAreP}</p>

				<h2 class="page-content__heading">{t.about.whyChania}</h2>
				<p>{t.about.whyChaniaP}</p>

				<h2 class="page-content__heading">{t.about.whatWeOffer}</h2>
				<p>{t.about.whatWeOfferP}</p>

				<div class="page-content__cta-wrap">
					<a href={`/${lang}/rentals`} class="page-content__cta">{t.about.ctaRent}</a>
					<a href={`/${lang}/contact`} class="page-content__cta page-content__cta--secondary">{t.about.contactUs}</a>
				</div>
			</div>
		</section>
	</main>

	<style is:global>
		.page { padding-top: 70px; }
		.page-hero {
			background-color: #1d8299;
			color: #fff;
			text-align: center;
			padding: 3rem 2rem;
		}
		.page-hero__title {
			margin: 0 0 0.5rem;
			font-size: clamp(2rem, 4vw, 3rem);
			font-weight: 700;
		}
		.page-hero__subtitle {
			margin: 0;
			font-size: 1.1rem;
			opacity: 0.95;
		}
		.page-content {
			padding: 3rem 2rem 4rem;
		}
		.page-content__inner {
			max-width: 720px;
			margin: 0 auto;
		}
		.page-content__heading {
			font-size: 1.5rem;
			margin: 2rem 0 0.75rem;
			color: #1a1a1a;
		}
		.page-content__heading:first-child { margin-top: 0; }
		.page-content p {
			line-height: 1.7;
			margin: 0 0 1rem;
			color: #333;
		}
		.page-content__cta-wrap {
			display: flex;
			flex-wrap: wrap;
			gap: 1rem;
			margin-top: 2.5rem;
		}
		.page-content__cta {
			display: inline-block;
			padding: 0.75rem 1.75rem;
			border-radius: 6px;
			font-size: 0.9rem;
			font-weight: 500;
			text-decoration: none;
			transition: background-color 160ms ease-out, border-color 160ms ease-out;
		}
		.page-content__cta:first-child {
			background-color: #1d8299;
			color: #fff;
			border: 1px solid #1d8299;
		}
		.page-content__cta:first-child:hover {
			background-color: #176b7d;
			border-color: #176b7d;
		}
		.page-content__cta--secondary {
			background-color: transparent;
			color: #1a1a1a;
			border: 1px solid #c4a574;
		}
		.page-content__cta--secondary:hover {
			background-color: #f5f0e6;
		}
	</style>
</PublicLayout>
