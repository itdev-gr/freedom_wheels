---
const title = 'Book Now | Freedom Wheels – Scooter Rental Chania';
const description = 'Book your scooter rental in Chania with Freedom Wheels. Choose your dates and model. We\'ll confirm your reservation by email or phone.';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/logos/logo.webp', Astro.site).href;
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="el_GR" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<link rel="icon" type="image/webp" href="/logos/logo.webp" />
		<link rel="apple-touch-icon" href="/logos/logo.webp" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<section class="book-hero">
			<img src="/images/book-mopeds.png" alt="Couples enjoying a moped ride on a scenic road in Crete" class="book-hero__img" />
		</section>
		<header class="nav-bar nav-bar--scrolled" id="nav-bar">
			<div class="nav-bar__inner">
				<a href="/" class="logo">
					<img src="/logos/logo.webp" alt="Freedom Wheels" class="logo__image" />
				</a>
				<nav class="nav-bar__links">
					<a href="/rentals" class="nav-bar__link">Rentals</a>
					<a href="/chania" class="nav-bar__link">Chania</a>
					<a href="/about" class="nav-bar__link">About us</a>
					<a href="/contact" class="nav-bar__link">Contact</a>
					<a href="/book" class="nav-bar__cta nav-bar__cta--active">Book now</a>
				</nav>
			</div>
		</header>

		<main class="page page--image-top">
			<section class="book-cards">
				<div class="book-cards__inner">
					<article class="book-card">
						<div class="book-card__img-wrap">
							<img src="/images/sh-125.png" alt="SH 125cc" class="book-card__img" />
						</div>
						<h3 class="book-card__title">SH 125cc</h3>
						<ul class="book-card__features">
							<li><span class="book-card__check" aria-hidden="true">✓</span> Includes basic insurance</li>
							<li><span class="book-card__check" aria-hidden="true">✓</span> Free helmets</li>
							<li><span class="book-card__check" aria-hidden="true">✓</span> Free mobile phone holder</li>
							<li><span class="book-card__check" aria-hidden="true">✓</span> Top case</li>
							<li><span class="book-card__check" aria-hidden="true">✓</span> Unlimited mileage</li>
						</ul>
						<a href="/booking?model=sh-125" class="book-card__btn" target="_blank" rel="noopener noreferrer">Book Now</a>
					</article>
					<article class="book-card">
						<div class="book-card__img-wrap">
							<img src="/images/liberty-125.png" alt="LIBERTY 125cc" class="book-card__img" />
						</div>
						<h3 class="book-card__title">LIBERTY 125cc</h3>
						<ul class="book-card__features">
							<li><span class="book-card__check" aria-hidden="true">✓</span> Includes basic insurance</li>
							<li><span class="book-card__check" aria-hidden="true">✓</span> Free helmets</li>
							<li><span class="book-card__check" aria-hidden="true">✓</span> Free mobile phone holder</li>
							<li><span class="book-card__check" aria-hidden="true">✓</span> Top case</li>
							<li><span class="book-card__check" aria-hidden="true">✓</span> Unlimited mileage</li>
						</ul>
						<a href="/booking?model=liberty-125" class="book-card__btn" target="_blank" rel="noopener noreferrer">Book Now</a>
					</article>
					<article class="book-card">
						<div class="book-card__img-wrap">
							<img src="/images/sim-200.png" alt="SIM 200cc" class="book-card__img" />
						</div>
						<h3 class="book-card__title">SIM 200cc</h3>
						<ul class="book-card__features">
							<li><span class="book-card__check" aria-hidden="true">✓</span> Includes basic insurance</li>
							<li><span class="book-card__check" aria-hidden="true">✓</span> Free helmets</li>
							<li><span class="book-card__check" aria-hidden="true">✓</span> Free mobile phone holder</li>
							<li><span class="book-card__check" aria-hidden="true">✓</span> Top case</li>
							<li><span class="book-card__check" aria-hidden="true">✓</span> Unlimited mileage</li>
						</ul>
						<a href="/booking?model=sim-200" class="book-card__btn" target="_blank" rel="noopener noreferrer">Book Now</a>
					</article>
					<article class="book-card">
						<div class="book-card__img-wrap">
							<img src="/images/voge-rally-300.png" alt="VOGE RALLY 300cc" class="book-card__img" />
						</div>
						<h3 class="book-card__title">VOGE RALLY 300cc</h3>
						<ul class="book-card__features">
							<li><span class="book-card__check" aria-hidden="true">✓</span> Includes basic insurance</li>
							<li><span class="book-card__check" aria-hidden="true">✓</span> Free helmets</li>
							<li><span class="book-card__check" aria-hidden="true">✓</span> Free mobile phone holder</li>
							<li><span class="book-card__check" aria-hidden="true">✓</span> Top case</li>
							<li><span class="book-card__check" aria-hidden="true">✓</span> Unlimited mileage</li>
						</ul>
						<a href="/booking?model=voge-rally-300" class="book-card__btn" target="_blank" rel="noopener noreferrer">Book Now</a>
					</article>
				</div>
			</section>
		</main>


		<footer class="site-footer">
			<div class="site-footer__inner">
				<div class="site-footer__col site-footer__company">
					<div class="site-footer__logo">
						<img src="/logos/logo.webp" alt="Freedom Wheels" class="site-footer__logo-img" />
						<span class="site-footer__name">FREEDOM WHEELS</span>
					</div>
					<ul class="site-footer__contact">
						<li>
							<span class="site-footer__icon" aria-hidden="true">📍</span>
							<span>7 Apokoronou Str, 73100 Chania, Crete, Greece</span>
						</li>
						<li>
							<span class="site-footer__icon" aria-hidden="true">📞</span>
							<a href="tel:+302821405794">+30 2821 405 794</a>
						</li>
						<li>
							<span class="site-footer__icon" aria-hidden="true">✉️</span>
							<a href="mailto:info@freedomwheels.gr">info@freedomwheels.gr</a>
						</li>
						<li><span>GEMI No.: —</span></li>
					</ul>
				</div>
				<div class="site-footer__col site-footer__links">
					<h3 class="site-footer__heading">About</h3>
					<ul>
						<li><a href="/#terms">Rental Terms</a></li>
						<li><a href="/#policy">Booking & Cancellation Policy</a></li>
						<li><a href="/#cookies">Cookie Policy</a></li>
						<li><a href="/#terms-use">Terms of Use</a></li>
						<li><a href="/#privacy">Privacy Policy</a></li>
						<li><a href="/#payment">Payment Methods</a></li>
						<li><a href="/contact">Contact</a></li>
					</ul>
				</div>
				<div class="site-footer__col site-footer__hours">
					<h3 class="site-footer__heading">Opening Hours</h3>
					<p class="site-footer__hours-text">Mon - Fri: 09:00 - 19:00</p>
					<p class="site-footer__hours-text">Sat: 09:00 - 14:00</p>
					<p class="site-footer__hours-text">Sun: Closed</p>
				</div>
			</div>
			<div class="site-footer__bottom">
				<p class="site-footer__copyright">Copyright 2026 © Freedom Wheels · Powered by <a href="https://www.itdev.gr/" target="_blank" rel="noopener noreferrer">IT DEV</a></p>
			</div>
		</footer>

		<style>
			:root {
				--font-heading: Georgia, 'Times New Roman', serif;
				--font-body: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				padding: 0;
				font-family: var(--font-body);
				background-color: #ffffff;
				color: #1a1a1a;
			}

			body {
				min-height: 100vh;
			}

			.page {
				padding-top: 70px;
			}

			.page--image-top {
				padding-top: 0;
			}

			.visually-hidden {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}

			.nav-bar {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 30;
				background-color: transparent;
				backdrop-filter: blur(8px);
				transition: background-color 200ms ease-out, box-shadow 200ms ease-out;
			}

			.nav-bar--scrolled {
				background-color: rgba(85, 83, 86, 0.5);
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
			}

			.nav-bar__inner {
				max-width: 1200px;
				margin: 0 auto;
				padding: 0.85rem 2rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 2rem;
			}

			.logo {
				display: inline-flex;
				align-items: center;
				gap: 0.65rem;
				color: #ffffff;
				text-decoration: none;
			}

			.logo__image {
				height: 48px;
				width: auto;
				display: block;
			}

			.logo__text {
				font-family: var(--font-body);
				font-size: 0.7rem;
				letter-spacing: 0.24em;
				text-transform: uppercase;
				white-space: nowrap;
				font-weight: 500;
			}

			.nav-bar__links {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
			}

			.nav-bar__link {
				font-family: var(--font-body);
				display: inline-block;
				padding: 0.5rem 1rem;
				border-radius: 999px;
				background-color: rgba(128, 128, 128, 0.85);
				color: #ffffff;
				font-size: 0.75rem;
				font-weight: 500;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				text-decoration: none;
				transition: background-color 150ms ease-out;
			}

			.nav-bar__link:hover,
			.nav-bar__link--active {
				background-color: rgba(100, 100, 100, 0.95);
				color: #ffffff;
			}

			.nav-bar__cta {
				font-family: var(--font-body);
				display: inline-block;
				padding: 0.5rem 1.25rem;
				border-radius: 999px;
				background-color: #1a1a1a;
				color: #ffffff;
				font-size: 0.75rem;
				font-weight: 600;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				text-decoration: none;
				transition: background-color 150ms ease-out;
			}

			.nav-bar__cta:hover {
				background-color: #333;
			}

			.nav-bar__cta--active {
				background-color: #1d8299;
			}

			.nav-bar__cta--active:hover {
				background-color: #176b7d;
			}

			.book-hero {
				width: 100%;
				height: 76.5vh;
				max-height: 76.5vh;
				overflow: hidden;
			}

			.book-hero__img {
				width: 100%;
				height: 100%;
				display: block;
				object-fit: cover;
			}

			.book-cards {
				background: #f8f9fa;
				padding: 3rem 2rem 4rem;
			}

			.book-cards__inner {
				max-width: 1200px;
				margin: 0 auto;
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1.5rem;
			}

			.book-card {
				background: #fff;
				border-radius: 12px;
				box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				align-items: center;
			}

			.book-card__img-wrap {
				width: 100%;
				height: 170px;
				display: flex;
				align-items: center;
				justify-content: center;
				margin-bottom: 1rem;
			}

			.book-card__img {
				width: 100%;
				height: 100%;
				object-fit: contain;
				display: block;
			}

			.book-card__title {
				font-family: var(--font-body);
				font-size: 1.1rem;
				font-weight: 700;
				color: #1a1a1a;
				margin: 0 0 1rem;
				text-align: center;
			}

			.book-card__features {
				list-style: none;
				margin: 0 0 1.25rem;
				padding: 0;
				width: 100%;
			}

			.book-card__features li {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.9rem;
				color: #555;
				margin-bottom: 0.4rem;
			}

			.book-card__check {
				color: #22c55e;
				font-weight: 700;
				flex-shrink: 0;
			}

			.book-card__btn {
				display: block;
				width: 100%;
				text-align: center;
				padding: 0.75rem 1rem;
				background: #1d8299;
				color: #fff;
				font-family: var(--font-body);
				font-size: 0.95rem;
				font-weight: 600;
				text-decoration: none;
				border-radius: 8px;
				transition: background-color 0.2s ease;
			}

			.book-card__btn:hover {
				background: #176b7d;
			}

			@media (max-width: 900px) {
				.book-cards__inner {
					grid-template-columns: repeat(2, 1fr);
				}
			}

			@media (max-width: 500px) {
				.book-cards__inner {
					grid-template-columns: 1fr;
				}
			}

			.site-footer {
				background-color: #1d8299;
				color: #fff;
				padding: 3rem 2rem 0;
				font-family: var(--font-body);
			}

			.site-footer__inner {
				max-width: 1200px;
				margin: 0 auto;
				display: flex;
				gap: 3rem;
				flex-wrap: wrap;
				padding-bottom: 2rem;
			}

			.site-footer__col {
				flex: 1 1 200px;
				min-width: 0;
			}

			.site-footer__company {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.site-footer__logo {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.site-footer__logo-img {
				height: 48px;
				width: auto;
				object-fit: contain;
			}

			.site-footer__name {
				font-size: 1.25rem;
				font-weight: 600;
				letter-spacing: 0.05em;
				color: #fff;
			}

			.site-footer__contact {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}

			.site-footer__contact li {
				display: flex;
				align-items: flex-start;
				gap: 0.5rem;
			}

			.site-footer__icon {
				flex-shrink: 0;
			}

			.site-footer__contact a,
			.site-footer__contact span {
				color: #fff;
				text-decoration: none;
				font-size: 0.95rem;
			}

			.site-footer__contact a:hover {
				text-decoration: underline;
			}

			.site-footer__heading {
				font-size: 1.1rem;
				font-weight: 600;
				margin: 0 0 1rem;
				color: #fff;
				letter-spacing: 0.02em;
			}

			.site-footer__links ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.site-footer__links li {
				margin-bottom: 0.4rem;
			}

			.site-footer__links a {
				color: #fff;
				text-decoration: none;
				font-size: 0.95rem;
			}

			.site-footer__links a:hover {
				text-decoration: underline;
			}

			.site-footer__hours-text {
				margin: 0 0 0.4rem;
				font-size: 0.95rem;
				color: #fff;
			}

			.site-footer__bottom {
				border-top: 1px solid rgba(255, 255, 255, 0.35);
				padding: 1rem 2rem;
				text-align: left;
			}

			.site-footer__copyright {
				margin: 0;
				font-size: 0.85rem;
				color: rgba(255, 255, 255, 0.85);
			}

			.site-footer__copyright a {
				color: rgba(255, 255, 255, 0.9);
				text-decoration: none;
			}

			.site-footer__copyright a:hover {
				text-decoration: underline;
			}

			@media (max-width: 900px) {
				.nav-bar__links {
					display: none;
				}
			}
		</style>
	</body>
</html>
