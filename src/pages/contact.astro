		<style>
			:root {
				--font-heading: Georgia, 'Times New Roman', serif;
				--font-body: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				padding: 0;
				font-family: var(--font-body);
				background-color: #ffffff;
				color: #1a1a1a;
			}

			body {
				min-height: 100vh;
			}

			.page {
				padding-top: 70px;
			}

			.nav-bar {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 30;
				background-color: transparent;
				backdrop-filter: blur(8px);
				transition: background-color 200ms ease-out, box-shadow 200ms ease-out;
			}

			.nav-bar--scrolled {
				background-color: rgba(85, 83, 86, 0.5);
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
			}

			.nav-bar__inner {
				max-width: 1200px;
				margin: 0 auto;
				padding: 0.85rem 2rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 2rem;
			}

			.logo {
				display: inline-flex;
				align-items: center;
				gap: 0.65rem;
				color: #ffffff;
				text-decoration: none;
			}

			.logo__image {
				height: 48px;
				width: auto;
				display: block;
			}

			.logo__text {
				font-family: var(--font-body);
				font-size: 0.7rem;
				letter-spacing: 0.24em;
				text-transform: uppercase;
				white-space: nowrap;
				font-weight: 500;
			}

			.nav-bar__links {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
			}

			.nav-bar__link {
				font-family: var(--font-body);
				display: inline-block;
				padding: 0.5rem 1rem;
				border-radius: 999px;
				background-color: rgba(128, 128, 128, 0.85);
				color: #ffffff;
				font-size: 0.75rem;
				font-weight: 500;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				text-decoration: none;
				transition: background-color 150ms ease-out;
			}

			.nav-bar__link:hover,
			.nav-bar__link--active {
				background-color: rgba(100, 100, 100, 0.95);
				color: #ffffff;
			}

			.nav-bar__cta {
				font-family: var(--font-body);
				display: inline-block;
				padding: 0.5rem 1.25rem;
				border-radius: 999px;
				background-color: #1a1a1a;
				color: #ffffff;
				font-size: 0.75rem;
				font-weight: 600;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				text-decoration: none;
				transition: background-color 150ms ease-out;
			}

			.nav-bar__cta:hover {
				background-color: #333;
			}

			/* Contact hero: background image + cards */
			.contact-hero {
				position: relative;
				min-height: 520px;
				background-image: url("/images/chania%20port.jpg");
				background-size: cover;
				background-position: center;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 3rem 1.5rem 4rem;
			}

			.contact-hero__overlay {
				position: absolute;
				inset: 0;
				background: rgba(0, 0, 0, 0.35);
			}

			.contact-hero__content {
				position: relative;
				z-index: 1;
				width: 100%;
				max-width: 900px;
				display: flex;
				flex-direction: column;
				align-items: center;
			}

			.contact-cards {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1.25rem;
				width: 100%;
				max-width: 1100px;
			}

			.contact-card {
				background: #fff;
				border-radius: 12px;
				padding: 1.5rem;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
				transition: transform 0.25s ease-out, box-shadow 0.25s ease-out;
			}

			.contact-card:hover {
				transform: translateY(-4px);
				box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
			}

			.contact-card__icon {
				color: #ea580c;
				margin-bottom: 0.75rem;
			}

			.contact-card__title {
				font-family: var(--font-body);
				font-size: 1rem;
				font-weight: 600;
				color: #2a9fb5;
				margin: 0 0 0.5rem;
			}

			.contact-card__text {
				font-size: 0.95rem;
				line-height: 1.5;
				color: #374151;
				margin: 0;
			}

			.contact-card__text a {
				color: #2a9fb5;
				text-decoration: none;
			}

			.contact-card__text a:hover {
				text-decoration: underline;
			}

			.contact-form-wrap {
				background: #f8f9fa;
				padding: 3rem 2rem 4rem;
			}

			.contact-form-wrap__inner {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2rem;
				max-width: 1200px;
				margin: 0 auto;
				align-items: start;
			}

			.contact-form-section {
				background: #fff;
				border-radius: 12px;
				padding: 2rem;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
			}

			.contact-map {
				position: relative;
				width: 100%;
				min-height: 400px;
				background: #e5e7eb;
				border-radius: 12px;
				overflow: hidden;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
			}

			.contact-map iframe {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				min-height: 400px;
			}

			.contact-form-section__title {
				font-family: var(--font-body);
				font-size: 1.25rem;
				font-weight: 600;
				color: #2a9fb5;
				margin: 0 0 1.5rem;
			}

			.contact-form {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.contact-form__row {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
			}

			.contact-form__label {
				font-size: 0.9rem;
				font-weight: 500;
				color: #374151;
			}

			.contact-form__input {
				font-family: var(--font-body);
				font-size: 1rem;
				padding: 0.65rem 0.85rem;
				border: 1px solid #d1d5db;
				border-radius: 8px;
				background: #fff;
				color: #1a1a1a;
				transition: border-color 0.2s ease, box-shadow 0.2s ease;
			}

			.contact-form__input:focus {
				outline: none;
				border-color: #2a9fb5;
				box-shadow: 0 0 0 3px rgba(42, 159, 181, 0.2);
			}

			.contact-form__textarea {
				resize: vertical;
				min-height: 120px;
			}

			.contact-form__submit {
				font-family: var(--font-body);
				font-size: 0.95rem;
				font-weight: 600;
				color: #fff;
				background: #2a9fb5;
				border: none;
				border-radius: 8px;
				padding: 0.75rem 1.5rem;
				margin-top: 0.25rem;
				cursor: pointer;
				transition: background-color 0.25s ease-out, transform 0.2s ease-out;
			}

			.contact-form__submit:hover {
				background: #1f7a8c;
				transform: translateY(-1px);
			}

			/* Footer */
			.site-footer {
				background-color: #1d8299;
				color: #fff;
				padding: 3rem 2rem 0;
				font-family: var(--font-body);
			}

			.site-footer__inner {
				max-width: 1200px;
				margin: 0 auto;
				display: flex;
				gap: 3rem;
				flex-wrap: wrap;
				padding-bottom: 2rem;
			}

			.site-footer__col {
				flex: 1 1 200px;
				min-width: 0;
			}

			.site-footer__company {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.site-footer__logo {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.site-footer__logo-img {
				height: 48px;
				width: auto;
				object-fit: contain;
			}

			.site-footer__name {
				font-size: 1.25rem;
				font-weight: 600;
				letter-spacing: 0.05em;
				color: #fff;
			}

			.site-footer__contact {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}

			.site-footer__contact li {
				display: flex;
				align-items: flex-start;
				gap: 0.5rem;
			}

			.site-footer__icon {
				flex-shrink: 0;
			}

			.site-footer__contact a,
			.site-footer__contact span {
				color: #fff;
				text-decoration: none;
				font-size: 0.95rem;
			}

			.site-footer__contact a:hover {
				text-decoration: underline;
			}

			.site-footer__heading {
				font-size: 1.1rem;
				font-weight: 600;
				margin: 0 0 1rem;
				color: #fff;
				letter-spacing: 0.02em;
			}

			.site-footer__links ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.site-footer__links li {
				margin-bottom: 0.4rem;
			}

			.site-footer__links a {
				color: #fff;
				text-decoration: none;
				font-size: 0.95rem;
			}

			.site-footer__links a:hover {
				text-decoration: underline;
			}

			.site-footer__hours-text {
				margin: 0 0 0.4rem;
				font-size: 0.95rem;
				color: #fff;
			}

			.site-footer__bottom {
				border-top: 1px solid rgba(255, 255, 255, 0.35);
				padding: 1rem 2rem;
				text-align: left;
			}

			.site-footer__copyright {
				margin: 0;
				font-size: 0.85rem;
				color: rgba(255, 255, 255, 0.85);
			}

			.site-footer__copyright a {
				color: rgba(255, 255, 255, 0.9);
				text-decoration: none;
			}

			.site-footer__copyright a:hover {
				text-decoration: underline;
			}

			@media (max-width: 900px) {
				.contact-cards {
					grid-template-columns: 1fr;
				}

				.contact-form-wrap__inner {
					grid-template-columns: 1fr;
				}

				.contact-map {
					min-height: 300px;
				}

				.contact-map iframe {
					min-height: 300px;
				}

				.contact-hero {
					min-height: auto;
					padding: 2rem 1rem 3rem;
				}

				.site-footer__inner {
					flex-direction: column;
					gap: 2rem;
				}

				.nav-bar__links {
					display: none;
				}
			}
		</style>

		<script>
			document.getElementById('contact-form')?.addEventListener('submit', (e) => {
				e.preventDefault();
				// Connect to your backend or e.g. Formspree: form action="https://formspree.io/f/YOUR_ID" method="POST"
				alert('Ευχαριστούμε! Θα επικοινωνήσουμε μαζί σας σύντομα.');
			});
		</script>
	</body>
</html>
