---
export const prerender = false;

const host = Astro.request.headers.get('host') || '';
const forwardedHost = Astro.request.headers.get('x-forwarded-host') || '';
if (host.includes('admin.itdevtesting.com') || forwardedHost.includes('admin.itdevtesting.com')) {
	return Astro.redirect('/admin');
}

const title = 'Freedom Wheels | Rent a Scooter in Chania, Crete';
const description = 'Rent a scooter in Chania with Freedom Wheels. Explore the old town, harbour and beaches. Well-maintained scooters, helmets included. Book online or contact us.';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/logos/logo.webp', Astro.site).href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	name: 'Freedom Wheels',
	description: description,
	url: Astro.site,
	image: ogImage,
	address: { '@type': 'PostalAddress', streetAddress: '7 Apokoronou Str', addressLocality: 'Chania', postalCode: '73100', addressRegion: 'Crete', addressCountry: 'GR' },
	telephone: '+30 2821 405 794',
	email: 'info@freedomwheels.gr',
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '19:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '14:00' },
	],
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="el_GR" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<link rel="icon" type="image/webp" href="/logos/logo.webp" />
		<link rel="apple-touch-icon" href="/logos/logo.webp" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<main class="hero">
			<div class="hero__media">
				<video
					class="hero__video"
					src="/videos/chania-scooter.mp4"
					autoplay
					muted
					loop
					playsinline
				></video>
				<div class="hero__overlay"></div>
			</div>

			<header class="nav-bar" id="nav-bar">
				<div class="nav-bar__inner">
					<div class="logo">
						<img
							src="/logos/logo.webp"
							alt="Freedom Wheels"
							class="logo__image"
						/>
					</div>
					<nav class="nav-bar__links">
						<a href="/rentals" class="nav-bar__link">Rentals</a>
						<a href="/chania" class="nav-bar__link">Chania</a>
						<a href="/about" class="nav-bar__link">About us</a>
						<a href="/contact" class="nav-bar__link">Contact</a>
						<a href="/book" class="nav-bar__cta">Book now</a>
					</nav>
				</div>
			</header>

			<section class="hero__content">
				<div class="hero__headline">
					<h1 class="hero__title">
						Rent a Scooter in <span>Chania</span>
					</h1>
					<div class="hero__divider"></div>
				</div>
				<p class="hero__subtitle">
					Premium scooter hire for leisure &amp; island adventures
				</p>
			</section>
		</main>

		<section class="rent-ebike">
			<div class="rent-ebike__inner">
				<div class="rent-ebike__image">
					<img src="/images/rent-a-scooter-athens.png" alt="Scooter rental by the sea" />
				</div>
				<div class="rent-ebike__content">
					<h2 class="rent-ebike__title">About Freedom Wheels Chania</h2>
					<div class="rent-ebike__body">
						<p>Freedom Wheels is your scooter rental specialist in Chania. We offer a wide range of well-maintained scooters so you can explore the old town, the harbour and the coast at your own pace.</p>
						<p>Our scooters are ideal for visitors and locals alike. We provide helmets and full support so your ride in Chania is safe and hassle-free. Contact us or book online to rent a scooter in Chania.</p>
					</div>
					<a href="#rent" class="rent-ebike__cta">Rent a Scooter Chania</a>
				</div>
			</div>
		</section>

		<section class="sivota-rentals">
			<div class="sivota-rentals__inner">
				<div class="sivota-rentals__content">
					<h2 class="sivota-rentals__title">Discover Chania</h2>
					<div class="sivota-rentals__body">
						<p>Chania’s old town and Venetian harbour are perfect to explore on two wheels. From the lighthouse and the narrow streets to the waterfront tavernas, a scooter lets you see the best of the city without the hassle of parking. Head west to the beaches of Agia Marina and Platanias or drive up to the hills for views over the bay. Whether you stay for a few hours or a full day, discovering Chania by scooter is one of the best ways to experience Crete.</p>
					</div>
					<a href="#discover" class="sivota-rentals__cta">Discover Chania</a>
				</div>
				<div class="sivota-rentals__image">
					<img src="/images/rent-a-scooter-athens.png" alt="Discover Chania by scooter" />
				</div>
			</div>
		</section>

		<footer class="site-footer">
			<div class="site-footer__inner">
				<div class="site-footer__col site-footer__company">
					<div class="site-footer__logo">
						<img src="/logos/logo.webp" alt="Freedom Wheels" class="site-footer__logo-img" />
						<span class="site-footer__name">FREEDOM WHEELS</span>
					</div>
					<ul class="site-footer__contact">
						<li>
							<span class="site-footer__icon" aria-hidden="true">📍</span>
							<span>7 Apokoronou Str, 73100 Chania, Crete, Greece</span>
						</li>
						<li>
							<span class="site-footer__icon" aria-hidden="true">📞</span>
							<a href="tel:+302821405794">+30 2821 405 794</a>
						</li>
						<li>
							<span class="site-footer__icon" aria-hidden="true">✉️</span>
							<a href="mailto:info@freedomwheels.gr">info@freedomwheels.gr</a>
						</li>
						<li><span>Αρ. ΓΕΜΗ: —</span></li>
					</ul>
				</div>
				<div class="site-footer__col site-footer__links">
					<h3 class="site-footer__heading">Σχετικά</h3>
					<ul>
						<li><a href="#terms">Όροι Σύμβασης Μίσθωσης</a></li>
						<li><a href="#policy">Πολιτική Κρατήσεων - Ακυρώσεων</a></li>
						<li><a href="#cookies">Πολιτική Cookies</a></li>
						<li><a href="#terms-use">Όροι Χρήσης</a></li>
						<li><a href="#privacy">Πολιτική Απορρήτου</a></li>
						<li><a href="#payment">Τρόποι Πληρωμής</a></li>
						<li><a href="/contact">Επικοινωνία</a></li>
					</ul>
				</div>
				<div class="site-footer__col site-footer__hours">
					<h3 class="site-footer__heading">Ωράριο</h3>
					<p class="site-footer__hours-text">Δευ - Παρ: 09:00 - 19:00</p>
					<p class="site-footer__hours-text">Σαβ: 09:00 - 14:00</p>
					<p class="site-footer__hours-text">Κυρ: Κλειστά</p>
				</div>
			</div>
			<div class="site-footer__bottom">
				<p class="site-footer__copyright">Copyright 2026 © Freedom Wheels · Powered by <a href="https://www.itdev.gr/" target="_blank" rel="noopener noreferrer">IT DEV</a></p>
			</div>
		</footer>

		<style>
			:root {
				color-scheme: dark;
				--font-heading: Georgia, 'Times New Roman', serif;
				--font-body: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
				--hero-text: #ffffff;
				--hero-subtitle: #ffffff;
				--hero-shadow: rgba(0, 0, 0, 0.5);
				--nav-bg: rgba(0, 0, 0, 0.45);
				--nav-border: rgba(255, 255, 255, 0.35);
				--accent: #f97316;
				--accent-dark: #ea580c;
				--accent-text: #111827;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				padding: 0;
				font-family: var(--font-body);
				color: var(--hero-text);
				background-color: #ffffff;
			}

			body {
				min-height: 100vh;
			}

			.hero {
				position: relative;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				align-items: stretch;
				justify-content: center;
				padding: 5.5rem 3rem 3rem;
				background-color: #ffffff;
				color: var(--hero-text);
				overflow: hidden;
			}

			.hero__media {
				position: absolute;
				inset: 0;
				overflow: hidden;
				z-index: 0;
			}

			.hero__video {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.hero__overlay {
				position: absolute;
				inset: 0;
				background: radial-gradient(
					circle at 50% 0%,
					rgba(255, 255, 255, 0.08),
					transparent 60%
				);
				mix-blend-mode: screen;
				pointer-events: none;
			}

			/* Sticky menu bar (template: logo left, grey pill links, dark BOOK NOW) */
			.nav-bar {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 30;
				background-color: transparent;
				backdrop-filter: none;
				transition: background-color 200ms ease-out, box-shadow 200ms ease-out, backdrop-filter 200ms ease-out;
			}

			.nav-bar--scrolled {
				background-color: rgba(85, 83, 86, 0.5);
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
				backdrop-filter: blur(8px);
			}

			.nav-bar__inner {
				max-width: 1200px;
				margin: 0 auto;
				padding: 0.85rem 2rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 2rem;
			}

			.logo {
				display: inline-flex;
				align-items: center;
				gap: 0.65rem;
				color: #ffffff;
			}

			.logo__image {
				height: 48px;
				width: auto;
				display: block;
				filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.6));
			}

			.logo__text {
				font-family: var(--font-body);
				font-size: 0.7rem;
				letter-spacing: 0.24em;
				text-transform: uppercase;
				white-space: nowrap;
				text-shadow: 0 2px 6px rgba(0, 0, 0, 0.7);
				font-weight: 500;
			}

			.nav-bar__links {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
			}

			.nav-bar__link {
				font-family: var(--font-body);
				display: inline-block;
				padding: 0.5rem 1rem;
				border-radius: 999px;
				background-color: rgba(128, 128, 128, 0.85);
				color: #ffffff;
				font-size: 0.75rem;
				font-weight: 500;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				text-decoration: none;
				text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
				transition: background-color 150ms ease-out, transform 120ms ease-out;
			}

			.nav-bar__link:hover {
				background-color: rgba(100, 100, 100, 0.95);
				color: #ffffff;
			}

			.nav-bar__cta {
				font-family: var(--font-body);
				display: inline-block;
				padding: 0.5rem 1.25rem;
				border-radius: 999px;
				background-color: #1a1a1a;
				color: #ffffff;
				font-size: 0.75rem;
				font-weight: 600;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				text-decoration: none;
				text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
				transition: background-color 150ms ease-out, transform 120ms ease-out;
			}

			.nav-bar__cta:hover {
				background-color: #333;
			}

			.hero__content {
				position: relative;
				z-index: 1;
				max-width: 960px;
				margin: 0 auto;
				flex: 1;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				gap: 0.5rem;
			}

			.hero__headline {
				display: inline-flex;
				flex-direction: column;
				align-items: stretch;
				text-align: center;
			}

			.hero__title {
				margin: 0;
				font-family: var(--font-heading);
				font-size: clamp(3.2rem, 5vw + 1.5rem, 4.6rem);
				font-weight: 700;
				letter-spacing: 0.02em;
				color: #ffffff;
				text-shadow:
					0 3px 8px rgba(0, 0, 0, 0.6),
					0 0 1px rgba(0, 0, 0, 0.8);
			}

			.hero__title span {
				font-weight: 800;
			}

			.hero__divider {
				width: 80%;
				max-width: 320px;
				height: 1px;
				margin: 0.75rem auto 0.75rem;
				background-color: rgba(255, 255, 255, 0.95);
			}

			.hero__subtitle {
				margin: 0;
				font-family: var(--font-body);
				font-size: 1.2rem;
				font-weight: 500;
				color: #ffffff;
				text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
			}

			/* Rent a Scooter section (image left, content right) */

			.rent-ebike {
				margin: 0;
				padding: 0;
				overflow: hidden;
			}

			.rent-ebike__inner {
				width: 100%;
				margin: 0;
				padding: 0;
				display: flex;
				align-items: stretch;
				min-height: 480px;
			}

			.rent-ebike__image {
				flex: 0 0 50%;
				min-height: 480px;
				overflow: hidden;
			}

			.rent-ebike__image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.rent-ebike__content {
				font-family: var(--font-body);
				flex: 0 0 50%;
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				padding: 3rem 3rem 3rem 2.5rem;
				background: #ffffff;
				color: #1a1a1a;
			}

			.rent-ebike__title {
				font-family: var(--font-heading);
				margin: 20% 0 1.5rem 0;
				font-size: 1.75rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.02em;
				color: #1a1a1a;
				line-height: 1.3;
				text-align: center;
			}

			.rent-ebike__body {
				flex: 1;
				margin: 0 0 1.5rem;
				max-width: 520px;
			}

			.rent-ebike__body p {
				font-family: var(--font-body);
				margin: 0 0 1rem;
				font-size: 0.95rem;
				line-height: 1.6;
				color: #333;
				text-align: center;
			}

			.rent-ebike__body p:last-child {
				margin-bottom: 0;
			}

			.rent-ebike__cta {
				font-family: var(--font-body);
				align-self: center;
				margin-top: 1.5rem;
				margin-bottom: 20%;
				padding: 0.75rem 2rem;
				border-radius: 6px;
				border: 1px solid #c4a574;
				background-color: #f5f0e6;
				color: #1a1a1a;
				font-size: 0.9rem;
				font-weight: 500;
				text-decoration: none;
				text-transform: none;
				transition: background-color 160ms ease-out, border-color 160ms ease-out;
			}

			.rent-ebike__cta:hover {
				background-color: #ebe5d9;
				border-color: #b3956a;
			}

			@media (max-width: 900px) {
				.rent-ebike__inner {
					flex-direction: column;
					min-height: auto;
				}

				.rent-ebike__image {
					flex: 0 0 auto;
					min-height: 280px;
				}

				.rent-ebike__content {
					flex: 0 0 auto;
					padding: 2rem 1.5rem;
				}

				.rent-ebike__title {
					font-size: 1.5rem;
				}

				.rent-ebike__body p {
					font-size: 0.9rem;
				}
			}

			/* Sivota rentals section (text left, image right) */
			.sivota-rentals {
				margin: 0;
				padding: 0;
				overflow: hidden;
			}

			.sivota-rentals__inner {
				width: 100%;
				margin: 0;
				padding: 0;
				display: flex;
				align-items: stretch;
				min-height: 520px;
			}

			.sivota-rentals__content {
				font-family: var(--font-body);
				flex: 0 0 50%;
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				padding: 3rem 2.5rem 3rem 3rem;
				background: #ffffff;
				color: #1a1a1a;
			}

			.sivota-rentals__title {
				font-family: var(--font-heading);
				margin: 20% 0 1.5rem 0;
				font-size: 1.6rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.02em;
				color: #1a1a1a;
				line-height: 1.3;
				text-align: center;
			}

			.sivota-rentals__body {
				flex: 1;
				margin: 0 0 1.5rem;
				max-width: 520px;
			}

			.sivota-rentals__body p {
				font-family: var(--font-body);
				margin: 0 0 1rem;
				font-size: 0.95rem;
				line-height: 1.6;
				color: #333;
				text-align: center;
			}

			.sivota-rentals__body p:last-child {
				margin-bottom: 0;
			}

			.sivota-rentals__cta {
				font-family: var(--font-body);
				align-self: center;
				margin-top: 1.5rem;
				margin-bottom: 20%;
				padding: 0.75rem 2rem;
				border-radius: 6px;
				border: 1px solid #c4a574;
				background-color: #f5f0e6;
				color: #1a1a1a;
				font-size: 0.9rem;
				font-weight: 500;
				text-decoration: none;
				text-transform: none;
				transition: background-color 160ms ease-out, border-color 160ms ease-out;
			}

			.sivota-rentals__cta:hover {
				background-color: #ebe5d9;
				border-color: #b3956a;
			}

			.sivota-rentals__image {
				flex: 0 0 50%;
				min-height: 520px;
				overflow: hidden;
			}

			.sivota-rentals__image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			@media (max-width: 900px) {
				.sivota-rentals__inner {
					flex-direction: column;
					min-height: auto;
				}

				.sivota-rentals__content {
					flex: 0 0 auto;
					padding: 2rem 1.5rem;
				}

				.sivota-rentals__image {
					flex: 0 0 auto;
					min-height: 280px;
				}

				.sivota-rentals__title {
					font-size: 1.4rem;
				}

				.sivota-rentals__body p {
					font-size: 0.9rem;
				}
			}

			/* Footer */
			.site-footer {
				background-color: #1d8299;
				color: #fff;
				padding: 3rem 2rem 0;
				font-family: var(--font-body);
			}

			.site-footer__inner {
				max-width: 1200px;
				margin: 0 auto;
				display: flex;
				gap: 3rem;
				flex-wrap: wrap;
				padding-bottom: 2rem;
			}

			.site-footer__col {
				flex: 1 1 200px;
				min-width: 0;
			}

			.site-footer__company {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.site-footer__logo {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.site-footer__logo-img {
				height: 48px;
				width: auto;
				object-fit: contain;
			}

			.site-footer__name {
				font-size: 1.25rem;
				font-weight: 600;
				letter-spacing: 0.05em;
				color: #fff;
			}

			.site-footer__contact {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}

			.site-footer__contact li {
				display: flex;
				align-items: flex-start;
				gap: 0.5rem;
			}

			.site-footer__icon {
				flex-shrink: 0;
			}

			.site-footer__contact a,
			.site-footer__contact span {
				color: #fff;
				text-decoration: none;
				font-size: 0.95rem;
			}

			.site-footer__contact a:hover {
				text-decoration: underline;
			}

			.site-footer__heading {
				font-size: 1.1rem;
				font-weight: 600;
				margin: 0 0 1rem;
				color: #fff;
				letter-spacing: 0.02em;
			}

			.site-footer__links ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.site-footer__links li {
				margin-bottom: 0.4rem;
			}

			.site-footer__links a {
				color: #fff;
				text-decoration: none;
				font-size: 0.95rem;
			}

			.site-footer__links a:hover {
				text-decoration: underline;
			}

			.site-footer__hours-text {
				margin: 0 0 0.4rem;
				font-size: 0.95rem;
				color: #fff;
			}

			.site-footer__bottom {
				border-top: 1px solid rgba(255, 255, 255, 0.35);
				padding: 1rem 2rem;
				text-align: left;
			}

			.site-footer__copyright {
				margin: 0;
				font-size: 0.85rem;
				color: rgba(255, 255, 255, 0.85);
			}

			.site-footer__copyright a {
				color: rgba(255, 255, 255, 0.9);
				text-decoration: none;
			}

			.site-footer__copyright a:hover {
				text-decoration: underline;
			}

			@media (max-width: 900px) {
				.site-footer__inner {
					flex-direction: column;
					gap: 2rem;
				}
			}

			@media (max-width: 900px) {
				.hero {
					padding-inline: 1.5rem;
					padding-top: 5rem;
				}

				.nav-bar__inner {
					flex-wrap: wrap;
					padding-inline: 1rem;
				}

				.nav-bar__links {
					display: none;
				}
			}
		</style>

		<script>
			if (typeof window !== 'undefined') {
				window.addEventListener('scroll', () => {
					const navBar = document.getElementById('nav-bar');
					if (!navBar) return;
					const hero = document.querySelector('.hero');
					const heroBottom = hero ? hero.offsetHeight : window.innerHeight;
					if (window.scrollY >= heroBottom) {
						navBar.classList.add('nav-bar--scrolled');
					} else {
						navBar.classList.remove('nav-bar--scrolled');
					}
				});
			}
		</script>
	</body>
</html>
